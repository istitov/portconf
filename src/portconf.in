#!/bin/bash
# Copyright megabaks
# Distributed under the terms of the GNU General Public License v3 or later
# ============================================================================
# === PRELUDE & HELPERS
# === set -e and EINFO_QUIET setup; NO_COLOR/TTY-gated ANSI codes;
# === _tmpfiles/_cleanup/trap; _mktemp, _sed_escape_pat/_rep, _tput, _cols.
# ============================================================================

# Source Gentoo helpers before strict mode: functions.sh uses ${KSH_VERSION}
# without a default and is not set -u-safe.
if [[ -f "/lib/gentoo/functions.sh" ]]; then
	# shellcheck source=/dev/null
	source /lib/gentoo/functions.sh
else
	# shellcheck source=/dev/null  # glob path; resolved at runtime
	source /usr/lib*/portage/bin/isolated-functions.sh
fi
set -euo pipefail
# sort_uniq_files / sort_uses use gawk's asorti() to keep each atom's
# header block attached to it across the alphabetical sort.  Probe
# early — a busybox / mawk / POSIX-only awk would otherwise error
# mid-mutation with no actionable diagnostic.  /usr/bin/awk is gawk
# by default on Gentoo; `eselect awk set …` can override.
if ! awk 'BEGIN { asorti(a, b) }' </dev/null >/dev/null 2>&1; then
	printf '%s\n' \
		"error: portconf requires gawk (sort_uniq_files / sort_uses use asorti)" \
		"       /usr/bin/awk on this host doesn't support it" \
		"       fix: emerge dev-lang/gawk && eselect awk set gawk" >&2
	exit 1
fi
# functions.sh references EINFO_QUIET without a default; initialize it so
# eend/einfo calls work under set -u.
EINFO_QUIET="${EINFO_QUIET:-}"
# ANSI color codes are emitted only when stdout is a TTY AND NO_COLOR is
# unset (https://no-color.org).  Piping output to a file or grep would
# otherwise leak terminal escape sequences into machine-readable output.
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
	green="\033[01;32m"
	red="\033[01;31m"
	restore="\033[00m"
	contrast="\033[1m"
	underline="\033[4m"
else
	green=""; red=""; restore=""; contrast=""; underline=""
fi
_tmpfiles=()
# _cleanup: remove every temp file registered via _mktemp; runs from the EXIT trap.
_cleanup() { [[ ${#_tmpfiles[@]} -gt 0 ]] && rm -f "${_tmpfiles[@]}"; :; }
trap _cleanup EXIT

# shellcheck disable=SC2120  # variadic forwarder — most callers don't pass args, but the function still accepts and forwards them when given.
_mktemp() {
	local f
	f="$(mktemp "$@")"
	_tmpfiles+=("$f")
	printf '%s\n' "$f"
}

# Escape a string for use as the PATTERN in `sed s|pattern|repl|` with '|'
# as the delimiter.  Handles backslash (must be first to avoid double-
# escaping), the delimiter itself, and the basic-regex metacharacters
# that come up in user-controlled atom strings (.,[,*,^,$).  Output the
# escaped value so callers can interpolate it directly.
#
# Used to harden every `sed -e "s|.*${atom}.*|...|"` call site against
# atoms with USE-dep brackets (`sys-apps/grep[static]`), versions with
# dots (`>=sys-apps/grep-3.0`), and wildcards (`*/depend-on-me-*`).
_sed_escape_pat() {
	local s="$1"
	s="${s//\\/\\\\}"; s="${s//|/\\|}"
	s="${s//./\\.}";  s="${s//\[/\\[}"
	s="${s//\*/\\*}"; s="${s//^/\\^}"
	s="${s//\$/\\\$}"
	printf '%s' "$s"
}

# Escape a string for use as the REPLACEMENT in `sed s|pat|repl|` with '|'
# as the delimiter.  Different rules: only \, |, and & need escaping in
# the replacement side.
_sed_escape_rep() {
	local s="$1"
	s="${s//\\/\\\\}"; s="${s//|/\\|}"; s="${s//&/\\&}"
	printf '%s' "$s"
}

# _drop_line FILE VALUE [field1]: delete lines of FILE matching VALUE as a
# trimmed LITERAL string (awk string equality, never a regex) — the whole line
# by default, or the first whitespace field when the 3rd arg is "field1" (drops
# an atom's entire entry, flags and all).  Replaces the fragile
# `sed -e "s|^${x}.*||"` / `s|${x}||` removals whose unanchored, over-broad, or
# unescaped patterns also deleted prefix-sibling or metachar-matching valid
# entries (removing `foo` nuked `foobar`; a bare `cat/pn` nuked every slot).
# String equality can never collateral-match.
_drop_line() {
	local f="$1" v="$2" mode="${3:-line}" tmp
	tmp="$(_mktemp)"
	if [[ "${mode}" == "field1" ]]; then
		awk -v v="${v}" 'BEGIN { gsub(/^[[:space:]]+|[[:space:]]+$/, "", v) }
			$1 == v { next } { print }' "${f}" > "${tmp}"
	else
		awk -v v="${v}" 'BEGIN { gsub(/^[[:space:]]+|[[:space:]]+$/, "", v) }
			{ t = $0; gsub(/^[[:space:]]+|[[:space:]]+$/, "", t) }
			t == v { next } { print }' "${f}" > "${tmp}"
	fi
	mv "${tmp}" "${f}"
}

# tput wrapper that no-ops when stdout isn't a TTY.  Cursor-control codes
# (sc, civis, el, el1, rc, cnorm) corrupt output when emitted to a pipe
# or file, and tput itself errors when $TERM is unset or dumb.
_tput() {
	[[ -t 1 ]] && tput "$@" 2>/dev/null || true
}

# Return terminal column count, falling back to 80 in non-TTY contexts.
# Used inside `fold -s -w "$(_cols)"` pipelines that line-wrap profile USE
# listings.
_cols() {
	if [[ -t 1 ]]; then
		tput cols 2>/dev/null || echo 80
	else
		echo 80
	fi
}
# ============================================================================
# === INIT
# === Version, env-overridable path roots (PKGDB/BRDIR/PORT_ETC/WORLD/DEP_PATH/
# === PORTCONF_CONF), state-var defaults, ARCH probe, /etc/portconf.conf source,
# === COUNT default, IGNORE pattern computation.  _compute_ignore is defined
# === here and invoked immediately below; everything else is source-time only.
# ============================================================================

PACKAGE_VERSION="@PACKAGE_VERSION@"
# All four path roots honor an environment override for testability and
# unusual prefixes (e.g. ROOT=/mnt/chroot installs).  Defaults match the
# canonical modern Gentoo layout.
PKGDB="${PKGDB:-/var/db/pkg}"
BRDIR="${BRDIR:-/var/lib/portconf}"
PORT_ETC="${PORT_ETC:-/etc/portage}"
WORLD="${WORLD:-/var/lib/portage/world}"
DEP_PATH="${DEP_PATH:-/var/cache/edb/dep}"
ARCH="$(eix --print DEFAULT_ARCH)"
yes=""
PRETEND=""
# Mutation tallies for the end-of-run status line (_status_pc, printed after
# the dispatch loop): _changes_seen marks that a mutating op ran at all,
# _changes_found counts files with a pending diff, _changes_applied the ones
# actually written.  diff_ask maintains all three.
_changes_seen=""
_changes_found=0
_changes_applied=0
eix_cache=""
IGNORE_CATEGORY=""
IGNORE_PN=""
COUNT=""
PORTDIR_OVERLAY=""
tmp_categories=""
PORTCONF_CONF="${PORTCONF_CONF:-/etc/portconf.conf}"
# shellcheck source=/dev/null  # user-supplied at runtime; not statically resolvable
[[ -f "${PORTCONF_CONF}" ]] && . "${PORTCONF_CONF}"
COUNT="${COUNT:-10}"
# Expand IGNORE_CATEGORY and IGNORE_PN (set by /etc/portconf.conf as
# space-separated names) into newline-separated grep regex patterns:
#   IGNORE_CATEGORY="dev-lang" → "dev-lang/.*"   (match any package in cat)
#   IGNORE_PN="gcc"            → ".*/gcc"        (match any cat for pkg)
# Then join into a single IGNORE pattern.  Factored out of the inline init
# block so the transformation is unit-testable without parameterising
# /etc/portconf.conf's hardcoded path.
_compute_ignore() {
	[[ -n "${IGNORE_CATEGORY}" ]] && IGNORE_CATEGORY="$(sed -e '/^$/d' -e 's/$/\/.*/g' <<< "$(tr "[:space:]" $'\n' <<< "${IGNORE_CATEGORY}")")"
	[[ -n "${IGNORE_PN}" ]] && IGNORE_PN="$(sed -e '/^$/d' -e 's/^/.*\//g' <<< "$(tr "[:space:]" $'\n' <<< "${IGNORE_PN}")")"
	IGNORE="${IGNORE_CATEGORY}
${IGNORE_PN}"
	IGNORE="$(sed -e '/^$/d' <<< "${IGNORE}")"
	IGNORE="${IGNORE:-'Hello, LOR! :3'}"
}
_compute_ignore
# ============================================================================
# === PROFILE RESOLUTION
# === Resolves /etc/make.profile -> effective profile USE flags.
# === sort_passed_uses, profile, all_use_all_profiles, profile_use, current_profile.
# === Source-time side effect (after profile() def): pre_profile / profile_uses /
# === PROFILE.  test_helper.bash resets PROFILE="" post-source.
# ============================================================================

# sort_passed_uses: dedup a space-separated USE-flag list; last-defined state wins.
sort_passed_uses(){
	uses=""
	for opt in ${1};do
		opt="${opt//\*/\\*}"
		uses="$(tr "[:space:]" $'\n' <<< "${uses}" | grep -v -e "^${opt#-}$" -e "^-${opt#-}$" | tr $'\n' " " || true)"
		uses+=" $(tr "[:space:]" $'\n' <<< "${1}" | grep -e "^${opt#-}$" -e "^-${opt#-}$" | tail -n1 || true)"
		unset opt
	done
	local -a _a
	read -ra _a <<< "${uses}"
	echo "${_a[*]}"
	unset uses _a
}
# profile: recursively read profile USE flags by walking parent files.
profile() {
	local use path USE=""
	# Profile make.defaults files reference vars from parent profiles that
	# may not be set yet; source them without set -u to avoid false errors.
	if [[ -f "${1}/make.defaults" ]]; then
		set +u
		. "${1}/make.defaults"
		set -u
	fi
	use="${USE}"
	if [[ -f "${1}/parent" ]]; then
		while IFS= read -r path; do
			use="$use $(profile "${1}/$path")"
		done < "${1}/parent"
	fi
	echo "${use}"
}

pre_profile=""
# Legacy /etc/make.profile (pre-portage-2.2) is honored only at the host
# layout, never via PORT_ETC override.  Modern path is ${PORT_ETC}/make.profile.
[[ -h "/etc/make.profile" ]] && pre_profile="$(profile "$(readlink -f /etc/make.profile)")"
[[ -h "${PORT_ETC}/make.profile" ]] && pre_profile="$(profile "$(readlink -f "${PORT_ETC}/make.profile")")"
profile_uses="$(sort_passed_uses "${pre_profile}")"
PROFILE="$(tr "[:space:]" $'\n' <<< "${profile_uses}")"
# all_use_all_profiles: print effective USE flags for every profile available via eselect.
all_use_all_profiles(){
	for target in $(eselect --brief profile list);do
		profile_uses="$(profile "${PORTDIR}/profiles/${target}")"
		USEs="$(sort_passed_uses "${profile_uses}")"
		printf '%b\n' "\n${green}${target}${restore}: ${USEs}" | fold -s -w "$(_cols)"
		unset USEs
	done
}
# profile_use: interactive `select` — print USE flags for a chosen profile.
profile_use(){
	PS3="$(printf '%b\n' "${contrast}Choose number:${restore} ")"
	select target in $(eselect --brief profile list);do
		profile_uses="$(profile "${PORTDIR}/profiles/${target}")"
		USEs="$(sort_passed_uses "${profile_uses}")"
		printf '%b\n' "\n${green}${target}${restore}: ${USEs}" | fold -s -w "$(_cols)"
		unset USEs
		break
	done
}
# current_profile: print USE flags for the currently active profile.
current_profile(){
	local link=""
	if [[ -h "/etc/make.profile" ]];then
		link="/etc/make.profile"
	elif [[ -h "${PORT_ETC}/make.profile" ]];then
		link="${PORT_ETC}/make.profile"
	fi
	# No profile symlink (an unconfigured tree, or a sandboxed PORT_ETC): report
	# cleanly instead of aborting on a failed readlink under set -e + pipefail.
	if [[ -z "${link}" ]];then
		printf '%b\n' "${red}No active profile${restore} (no make.profile symlink)"
		return 0
	fi
	target="$(readlink "${link}" | sed 's|.*/profiles/||')"
	USEs="$(sort_passed_uses "${PROFILE}")"
	printf '%b\n' "${green}${target}${restore}: ${USEs}" | fold -s -w "$(_cols)"
	unset USEs
}
# ============================================================================
# === make.conf USE BASELINE
# === Sources /etc/portage/make.conf (or legacy /etc/make.conf) to populate
# === MAKE_USES — the host USE-flag state used by use_makeconf / invalid_uses
# === to detect redundant entries.  Source-time only (no func defs).
# === test_helper.bash resets MAKE_USES="" post-source.
# ============================================================================

makefile=""
[[ -f "/etc/make.conf" ]] && makefile="/etc/make.conf"
[[ -f "${PORT_ETC}/make.conf" ]] && makefile="${PORT_ETC}/make.conf"
# make.conf may contain self-referencing expansions (FEATURES+=${FEATURES})
# that are not set -u-safe; source it without strict mode.
if [[ -n "${makefile}" ]]; then
	set +u
	# shellcheck source=/dev/null  # /etc/portage/make.conf, resolved at runtime
	. "${makefile}" 2>/dev/null || true
	set -u
fi
MAKE_USES="${USE:-}"
unset USE
# Default Portage tree location moved from /usr/portage to /var/db/repos/gentoo
# in the 2018-2019 Portage refresh.  The default only fires if neither the
# environment nor make.conf (sourced just above) sets PORTDIR — real systems
# almost always have one of those, so this is the chroot/test/minimal-host
# fallback.  /usr/portage is no longer a sensible default on any current
# Gentoo install.
PORTDIR="${PORTDIR:-/var/db/repos/gentoo}"
# ============================================================================
# === TIMESTAMP
# === timestamp — newest mtime across globs; used by backup/world_backup/overlays
# === for "is the snapshot stale?" decisions.
# ============================================================================

# timestamp: newest mtime across the given globs (empty if none exist).
timestamp(){
	stat -c %Y "${@}" 2>/dev/null | sort | tail -n1 || true
}
# ============================================================================
# === EIX BOOTSTRAP
# === repo_fix, rm_repo_fix, eix_check, eix_method.  -rc/--regen-cache builds a
# === fresh temp eix cache (eix_check); default reuses the host cache
# === (eix_method, prompts if rebuild needed).
# ============================================================================

# repo_fix: merge declared overlays' categories into Portage's view for this run.
repo_fix(){
	if [[ -n "${PORTDIR_OVERLAY}" ]];then
		for path in ${PORTDIR_OVERLAY};do
			local_categories="$(ls -d1 "${path}"/{*-*,virtual} 2>/dev/null | sed -e "s|${path}/||g" | sort -u || true)"
			portage_categoties="$(cat "${PORTDIR}/profiles/categories")"
			if [[ -n "$(grep -v "${portage_categoties}" <<< "${local_categories}" || true)" ]];then
				if [[ ! -f "${path}/profiles/categories" ]];then
					[[ ! -d "${path}/profiles" ]] && mkdir "${path}/profiles" && tmp_categories+=" ${path}/profiles"
					printf '%b\n' "Creating temporary 'categories': ${path}"
					echo "${local_categories}" >> "${path}/profiles/categories"
					tmp_categories+=" ${path}/profiles/categories"
				fi
			fi
		done
	fi
}
# rm_repo_fix: undo repo_fix — remove the merged-in overlay categories.
rm_repo_fix(){
	if [[ -n "${tmp_categories}" ]];then
		for tmp_category in ${tmp_categories};do
			rm -rf "${tmp_category}"
		done
	fi
}
# eix_check: build a fresh eix metadata cache in a temp file (-rc mode).
eix_check(){
	if [[ -n "$(eix --version 2>/dev/null)" ]];then
		printf '%b\n' "${underline}Creating new temporary cache.${restore}"
		repo_fix
		eix_cache="$(_mktemp)"
		chown portage:portage "${eix_cache}" 2>/dev/null || true
		export EIX_CACHEFILE="${eix_cache}"
		export OVERLAY_CACHE_METHOD="parse|ebuild*"
		eix-update
	else
		printf '%b\n' "${green}app-portage/eix${restore} ${red}not installed!${restore}"
		eend 1 2>/dev/null
		exit 1
	fi
	rm_repo_fix
}
# eix_method: reuse the host's eix cache, prompting if a rebuild is needed.
eix_method(){
	if [[ -n "$(eix --version 2>/dev/null)" ]];then
		if [[ "$(eix --print OVERLAY_CACHE_METHOD)" != "parse|ebuild*" ]];then
			[[ -n "${yes}" ]] && eix_check
			printf '%b' "\n${red}!default 'OVERLAY_CACHE_METHOD'${restore}${contrast}\nCreate temporary cache?${restore} [${green}Yes${restore}/${red}No${restore}] "
			while read x;do
				case ${x} in
					Yes | YES | yes | Y | y | "" )
						eix_check
						break;;
					No | NO | no | N | n )
						break;;
					* ) printf '%b' "Sorry, response '${x}' not understood. [${green}Yes${restore}/${red}No${restore}] "
						continue;;
				esac
			done
		fi
	else
		printf '%b\n' "${green}app-portage/eix${restore} ${red}not installed!${restore}"
		eend 1 2>/dev/null
		exit 1
	fi
}
# ============================================================================
# === BACKUP & RESTORE
# === backup, world_backup, restore, etc_restore, world_restore.
# === backup() runs unconditionally for every mutating arm (PRETEND gates the
# === downstream ops, not backup itself).  Snapshots land in $BRDIR.
# ============================================================================

# backup: tar $PORT_ETC to $BRDIR with rotation; called by every mutating flag (incl. under --pretend).
backup(){
	[[ -d "${BRDIR}" ]] || mkdir -p "${BRDIR}"
	tarballs="$(ls -1 --color=never "${BRDIR}")"
	oldest="$(head -n1 <<< "${tarballs}")"
	count="$( wc -l <<< "${tarballs}")"
	count="${count:-0}"
	# Derive the tar working dir from PORT_ETC instead of hardcoding /etc/,
	# so test sandboxes (PORT_ETC=/tmp/foo/portage) don't accidentally tar
	# the host's real /etc/portage tree.
	local port_parent="${PORT_ETC%/*}"
	local port_name="${PORT_ETC##*/}"
	# Pre-2.2-portage systems kept make.conf at /etc/make.conf instead of
	# inside the config dir.  Honor it only when PORT_ETC is at its default
	# location — a sandboxed PORT_ETC must never pull the host's real
	# /etc/make.conf into a test tarball.
	local legacy_makeconf=""
	[[ "${PORT_ETC}" == "/etc/portage" && -f "/etc/make.conf" ]] && legacy_makeconf="/etc/make.conf"
	if [[ -n "${legacy_makeconf}" ]];then
		etc_update="$(timestamp "${PORT_ETC}"/{*,*/*,*/*/*,*/*/*/*} "${legacy_makeconf}")"
	else
		etc_update="$(timestamp "${PORT_ETC}"/{*,*/*,*/*/*,*/*/*/*})"
	fi
	# Guard the empty case: an empty PORT_ETC makes timestamp emit nothing, so
	# without this the `(( etc_update > portconf_update ))` below hits an
	# arithmetic syntax error and falls through to "already up-to-date" — wrongly
	# skipping the backup. Mirrors the portconf_update default just below.
	etc_update="${etc_update:-0}"
	portconf_update="$(timestamp "${BRDIR}"/*)"
	portconf_update="${portconf_update:-0}"
	if (( "${etc_update}" > "${portconf_update}" ));then
		if (( "${count}" >= "${COUNT}" ));then
			rm "${BRDIR}/${oldest}"
		fi
		printf '%b\n' "${PORT_ETC} backup: ${green}creating${restore}..."
		name="${BRDIR}/portage_$(date +%g.%m.%d-%H:%M).tar.bz2"
		if [[ -n "${legacy_makeconf}" ]];then
			tar -jcf "${name}" -C "${port_parent}/" "${port_name}" "${legacy_makeconf##*/}"
		else
			tar -jcf "${name}" -C "${port_parent}/" "${port_name}"
		fi
		eend $? 2>/dev/null
	else
		printf '%b\n' "${PORT_ETC} backups: ${green}already up-to-date${restore}"
		eend $? 2>/dev/null
	fi
}
# world_backup: tar the world file to $BRDIR/world/ with rotation; idempotent on no-change.
world_backup(){
	world_dir="${BRDIR}/world"
	[[ -d "${world_dir}" ]] || mkdir -p "${world_dir}"
	tarballs="$(ls -1 --color=never "${world_dir}")"
	oldest="$(head -n1 <<< "${tarballs}")"
	count="$( wc -l <<< "${tarballs}")"
	count="${count:-0}"
	world_update="$(timestamp "${WORLD}")"
	portconf_update="$(timestamp "${world_dir}"/*)"
	portconf_update="${portconf_update:-0}"
	if (( "${world_update}" > "${portconf_update}" ));then
		if (( "${count}" >= "${COUNT}" ));then
			rm "${world_dir}/${oldest}"
		fi
		printf '%b\n' "world backup: ${green}creating${restore}..."
		name="${world_dir}/world_$(date +%g.%m.%d-%H:%M).tar.bz2"
		tar -jcf "${name}" -C "${WORLD%world}" world
		eend $? 2>/dev/null
	else
		printf '%b\n' "world backups: ${green}already up-to-date${restore}"
		eend $? 2>/dev/null
	fi
}
# restore: interactive — pick a backup tarball and extract over the target tree.
restore(){
	local tarballs src answer
	# Guard the listing: a glob with no match makes `ls` exit non-zero, which
	# would abort the whole run under set -e instead of saying "no backups".
	tarballs="$(ls -1 --color=never "${1}"/*.bz2 2>/dev/null || true)"
	if [[ -z "${tarballs}" ]];then
		printf '%b\n' "${red}No backups${restore} found in ${contrast}${1}${restore}"
		return 0
	fi
	tarballs="${tarballs//${1}\/}"
	tarballs="${tarballs//.tar.bz2/}"
	tarballs="${tarballs//${2}_/}"
	PS3="$(printf '%b\n' "${contrast}Choose number:${restore} ")"
	printf '%b\n' "${contrast}Available backups${restore}:"
	select answer in ${tarballs};do
		# An out-of-range / non-numeric choice leaves ${answer} empty; re-prompt
		# instead of falling through and wiping the target with nothing to put
		# back.
		[[ -z "${answer}" ]] && { printf '%b\n' "${red}Invalid choice${restore}"; continue; }
		src="${1}/${2}_${answer}.tar.bz2"
		# Validate the archive BEFORE touching the live tree.  The old code
		# wiped $5 first and swallowed a failed extract, so a corrupt/truncated
		# tarball left the target EMPTY with no way back.  `tar -t` it first and
		# bail untouched on failure.
		if ! tar -tf "${src}" >/dev/null 2>&1;then
			printf '%b\n' "${red}Backup ${answer} is unreadable or corrupt${restore}; nothing changed"
			return 1
		fi
		printf '%b\n' "Rolling back ${3} to the state ${green}${answer}${restore}"
		# $5 (optional) is the dir whose CONTENTS are wiped before extracting
		# (so the restore is authoritative -- leftover files don't survive).
		# find -delete handles an empty dir + weird names; ${5:-} is required
		# under set -u for the 4-arg (world_restore) callers.
		[[ -n "${5:-}" && -d "${5:-}" ]] && find "${5}" -mindepth 1 -delete 2>/dev/null
		if tar -xf "${src}" -C "${4}" 2>/dev/null;then
			eend 0 2>/dev/null
		else
			printf '%b\n' "${red}Extract failed${restore} for ${answer} (target may be incomplete)"
			eend 1 2>/dev/null
		fi
		break
	done
}
# etc_restore: wrapper — restore() applied to the /etc/portage snapshot set.
etc_restore(){
	# Tar extract destination is the parent dir of PORT_ETC (the tarball
	# contains a "portage" subdir as its top-level entry — see backup()).
	# 5th arg = PORT_ETC itself: restore() wipes its contents before extract.
	restore "${BRDIR}" "portage" "${PORT_ETC}" "${PORT_ETC%/*}/" "${PORT_ETC}"
}
# world_restore: wrapper — restore() applied to the world-file snapshot set.
world_restore(){
	restore "${BRDIR}/world" "world" "${WORLD}" "${WORLD%world}"
}
# ============================================================================
# === INTERACTIVE PROMPTS
# === diff_ask, remove_ask.  Bash `select` prompts driving mutating ops;
# === bats feeds these via `run <<< "...stdin..."`.
# ============================================================================

# diff_ask: show a diff for each pending change and prompt accept/skip/all.
diff_ask(){
	full_diff=""
	_changes_seen=1
	my_diff="$(diff "${1}" "${2}" | grep --color=never "[[:digit:]][a-z][[:digit:]]" || true)"
	if [[ -n "${my_diff}" ]];then
		_changes_found=$(( _changes_found + 1 ))
		while read subj;do
			old_num="$(tr ',' ' ' <<< "${subj%[a-z]*}")"
			[[ "$(wc -w <<< "${old_num}")" == "2" ]] && old_num="$(seq ${old_num})"
			new_num="$(tr ',' ' ' <<< "${subj#*[a-z]}")"
			[[ "$(wc -w <<< "${new_num}")" == "2" ]] && new_num="$(seq ${new_num})"

			action="$(grep -o "[a-z]" <<< "${subj}" || true)"
 			if [[ "${action}" == "a" ]];then
				for num in ${new_num};do
					[[ "${num}" != "0" ]] && full_diff+="${num}^#+#${green}$(sed -n "${num}p" "${2}")${restore}#"$'\n'
				done
			elif [[ "${action}" == "d" ]];then
				for num in ${old_num};do
					[[ "${num}" != "0" ]] && full_diff+="${num}^#-#${red}$(sed -n "${num}p" "${1}")${restore}#"$'\n'
				done
			elif [[ "${action}" == "c" ]];then
				for num in ${old_num};do
					[[ "${num}" != "0" ]] && full_diff+="${num}^#-#${red}$(sed -n "${num}p" "${1}")${restore}#"$'\n'
				done
				for num in ${new_num};do
					[[ "${num}" != "0" ]] && full_diff+="${num}^#+#${green}$(sed -n "${num}p" "${2}")${restore}#"$'\n'
				done
			fi
		done <<< "${my_diff}"
		printf '%b\n' "\n${contrast}Changes for ${green}${1}${restore}:${restore}"
		echo "###############################################"
		printf '%b\n' "${full_diff%\\n}" | column -s \^ -t
		echo "###############################################"
		if [[ -z "${yes}" && -z "${PRETEND}" ]];then
			printf '%b' "${contrast}Apply changes?${restore} [${green}Yes${restore}/${red}No${restore}] "
			# Read the answer from fd 9 (dispatch-entry stdin, see top of
			# DISPATCH).  Fall back to fd 0 when fd 9 isn't open — that
			# covers unit tests sourcing the script with PORTCONF_NO_MAIN
			# and feeding answers via `<<<`.
			local _ans_fd=9
			{ : <&9; } 2>/dev/null || _ans_fd=0
			while read -u "${_ans_fd}" x;do
				case ${x} in
					Yes | YES | yes | Y | y | "" )
						# Apply if the target is writable; report clearly if
						# not.  The old code refused every non-root user here
						# ("go away" + exit 1) while the -y path did an
						# unchecked mv -- the two now agree by just trying it.
						if mv "${2}" "${1}" 2>/dev/null;then
							chmod 0644 "${1}" 2>/dev/null
							_changes_applied=$(( _changes_applied + 1 ))
							unset full_diff
							return 0
						fi
						printf '%b\n' "${red}Could not write${restore} ${1} (need root? re-run with ${green}doas${restore}/${green}sudo${restore})"
						rm "${2}" 2>/dev/null
						return 1;;
					No | NO | no | N | n )
						unset full_diff
						rm "${2}" 2>/dev/null
						return 0;;
					* ) printf '%b' "Sorry, response '${x}' not understood. [${green}Yes${restore}/${red}No${restore}] "
						continue;;
				esac
			done
			# read returned non-zero = EOF: stdin was not an interactive
			# terminal and no answer was given.  Do NOT silently discard the
			# pending change (the old behaviour looked like a clean no-op).
			printf '%b\n' "\n${red}No answer read${restore} (stdin not an interactive terminal); nothing applied. Re-run with ${green}-y${restore} to apply non-interactively."
			rm "${2}" 2>/dev/null
			return 1
		elif [[ -n "${yes}" && -z "${PRETEND}" ]];then
			if mv "${2}" "${1}" 2>/dev/null;then
				chmod 0644 "${1}" 2>/dev/null
				_changes_applied=$(( _changes_applied + 1 ))
				unset full_diff
				return 0
			fi
			printf '%b\n' "${red}Could not write${restore} ${1} (need root? re-run with ${green}doas${restore}/${green}sudo${restore})"
			rm "${2}" 2>/dev/null
			return 1
		elif [[ -z "${yes}" && -n "${PRETEND}" ]];then
			unset full_diff
			rm "${2}" 2>/dev/null
			return 0
		fi
	fi
	rm "${2}" 2>/dev/null
	return 0
}
# remove_ask: prompt for confirmation before removing entries from package.* files.
remove_ask(){
	if [[ -z "${yes}" && -z "${PRETEND}" ]];then
		printf '%b' "${contrast}Remove${restore} ${green}${1}${restore}${contrast}?${restore} [${green}Yes${restore}/${red}No${restore}] "
		# Same stdin reroute as diff_ask — see comment there.
		local _ans_fd=9
		{ : <&9; } 2>/dev/null || _ans_fd=0
		while read -u "${_ans_fd}" x;do
			case ${x} in
				Yes | YES | yes | Y | y | "" )
					rm -rf "${1}" 2>/dev/null
					break;;
				No | NO | no | N | n )
					break;;
				* ) printf '%b' "Sorry, response '${x}' not understood. [${green}Yes${restore}/${red}No${restore}] "
					continue;;
			esac
		done
		eend $? 2>/dev/null
	elif [[ -n "${yes}" && -z "${PRETEND}" ]];then
		printf '%b\n' "${contrast}Removing${restore} ${green}${1}${restore}"
		rm -rf "${1}" 2>/dev/null
		eend $? 2>/dev/null
	elif [[ -z "${yes}" && -n "${PRETEND}" ]];then
		eend 0 2>/dev/null
	fi
}
# _status_pc: end-of-run status line so a mutating invocation is never silent.
# Reads the tallies diff_ask kept and speaks only when a mutating op actually
# ran (_changes_seen).  Purely additive: it runs after the dispatch loop, never
# gates control flow (so it can't break a prompt or a piped-in answer stream),
# and is exit-code transparent (captures and re-returns $?).  The abort paths
# (no answer read / cannot write) print their own specific message before
# exiting under set -e, so they never reach -- and don't need -- this summary.
_status_pc(){
	local _rc=$?
	[[ -n "${_changes_seen}" ]] || return ${_rc}
	local pending=$(( _changes_found - _changes_applied ))
	if [[ -n "${PRETEND}" ]];then
		if (( _changes_found > 0 ));then
			printf '%b\n' "${contrast}portconf:${restore} pretend (-p), ${_changes_found} file(s) would change, nothing written"
		else
			printf '%b\n' "${contrast}portconf:${restore} no changes needed"
		fi
	elif (( _changes_applied > 0 && pending == 0 ));then
		printf '%b\n' "${contrast}portconf:${restore} updated ${_changes_applied} file(s)"
	elif (( _changes_applied > 0 ));then
		printf '%b\n' "${contrast}portconf:${restore} updated ${_changes_applied} file(s), ${pending} still pending (re-run with -y)"
	elif (( pending > 0 ));then
		printf '%b\n' "${contrast}portconf:${restore} ${pending} file(s) have pending changes, none applied (re-run with -y)"
	else
		printf '%b\n' "${contrast}portconf:${restore} no changes needed"
	fi
	return ${_rc}
}
# ============================================================================
# === PACKAGE.* FILE OPS
# === sort_uniq_files, file_or_dir, rm_comments, rm_all_comments.
# === Generic operations over $PORT_ETC/package.*.  file_or_dir is the
# === type-agnostic walker most -t/-f subroutines build on.
# ============================================================================

# sort_uniq_files: sort + dedupe atoms in every package.* file under $PORT_ETC, preserving comments.
sort_uniq_files(){
	while IFS= read -r package; do
		tmp_sort="$(_mktemp)"
		printf '%b\n' "${underline}Sorting${restore} ${contrast}${package#${PORT_ETC}/}${restore}"

		# Comment-preserving sort: each atom is grouped with the
		# consecutive comment + blank lines immediately above it
		# ("header block").  When atoms are sorted, those header
		# blocks travel with their atom.  Trailing comments at end
		# of file emit verbatim at the end.  Duplicate atoms are
		# merged: per-atom opts are concatenated, deduplicated by
		# token (first-seen wins for order).  Requires gawk for
		# asorti — gawk is Gentoo's default awk (/usr/bin/awk
		# symlinks to it).
		awk '
			function dedup_opts(s,    a, n, i, out, seen) {
				delete seen
				n = split(s, a, /[[:space:]]+/)
				for (i = 1; i <= n; i++) {
					if (a[i] != "" && !(a[i] in seen)) {
						seen[a[i]] = 1
						out = (out == "" ? a[i] : out " " a[i])
					}
				}
				return out
			}
			/^[[:space:]]*$|^[[:space:]]*#/ {
				pending_header = pending_header $0 "\n"
				next
			}
			{
				atom = $1
				opts = substr($0, length($1) + 1)
				sub(/^[[:space:]]+/, "", opts)
				sub(/[[:space:]]+$/, "", opts)
				if (!(atom in atoms)) {
					atoms[atom] = opts
					headers[atom] = pending_header
				} else if (opts != "") {
					atoms[atom] = atoms[atom] " " opts
				}
				pending_header = ""
			}
			END {
				n = asorti(atoms, sorted)
				for (i = 1; i <= n; i++) {
					a = sorted[i]
					deduped = dedup_opts(atoms[a])
					if (deduped == "")
						printf "%s%s\n", headers[a], a
					else
						printf "%s%s %s\n", headers[a], a, deduped
				}
				if (pending_header != "") printf "%s", pending_header
			}
		' "${package}" > "${tmp_sort}"
		diff_ask "${package}" "${tmp_sort}"
		eend $? 2>/dev/null
	done < <(find "${PORT_ETC}/" -type f \! -name '*~' \! -name '*.bak' | grep "/package\." || true)
}
# file_or_dir: walker — apply a callback over package.* entries (file or directory).
file_or_dir(){
	local founded=""
	for i in ${1};do
		# `ls` returns exit 2 when the target doesn't exist; under set -e
		# the command substitution's failure propagates to this assignment
		# and the function exits 2 before reaching the empty-${founded}
		# diagnostic branch.  `|| true` lets the loop complete so the
		# downstream `[[ -z "${founded}" ]]` check reports "No such file"
		# cleanly.
		founded+=" $(ls -d1 "${PORT_ETC}/"${i} 2>/dev/null || true)"
	done
	# `founded` always has a leading space from `founded+=" "...`; strip
	# whitespace before testing for "no match" — otherwise the diagnostic
	# branch never fires and the function falls through to the no-op for
	# loop returning 0.
	if [[ -z "${founded// /}" ]];then
		printf '%b\n' "${underline}${2}${restore}${contrast}${PORT_ETC}/${1}${restore}: No such file or directory${restore}"
		eend 1 2>/dev/null
		return 1
	fi
	for target in ${founded};do
		if [[ -f "${target}" ]];then
			file="${target}"
			if [[ -s "${file}" ]];then
				printf '%b\n' "${underline}${2}${restore} ${contrast}${file#${PORT_ETC}/}${restore}"
				local _fn
				for _fn in "${3}" "${4:-}" "${5:-}" "${6:-}" "${7:-}"; do
					[[ -n "${_fn}" ]] || continue
					eval "${_fn}"
				done
			else
				printf '%b\n' "${underline}Empty file${restore} ${contrast}${file}${restore}"
				remove_ask "${file}"
				eend $? 2>/dev/null
			fi
		elif [[ -d "${target}" ]];then
			while IFS= read -r f; do
				file="${f}"
				if [[ -s "${file}" ]];then
					printf '%b\n' "${underline}${2}${restore} ${contrast}${file#${PORT_ETC}/}${restore}"
					local _fn
					for _fn in "${3}" "${4:-}" "${5:-}" "${6:-}" "${7:-}"; do
						[[ -n "${_fn}" ]] || continue
						eval "${_fn}"
					done
				else
					printf '%b\n' "${underline}Empty file${restore} ${contrast}${file}${restore}"
					remove_ask "${file}"
					eend $? 2>/dev/null
					continue
				fi
			done < <(find "${target}" -type f \! -name '*~' \! -name '*.bak')
		fi
	done
}
# rm_comments: strip standalone comment lines from package.* files.
rm_comments(){
	no_newline(){
		tmp_file="$(_mktemp)"
		cp "${file}" "${tmp_file}"
		sed -e "s|^#.*||g" -e '/^$/d' -i "${tmp_file}"
		diff_ask "${file}" "${tmp_file}"
		eend $? 2>/dev/null
	}
	file_or_dir "package.*" "Checking comments:" "no_newline" || true
}
# rm_all_comments: strip all comments (standalone + trailing) from package.* files.
rm_all_comments(){
	no_newline_inline(){
		tmp_file="$(_mktemp)"
		cp "${file}" "${tmp_file}"
		sed -e "s|#.*||g" -e 's/[ \t]*$//' -e '/^$/d' -i "${tmp_file}"
		diff_ask "${file}" "${tmp_file}"
		eend $? 2>/dev/null
	}
	file_or_dir "package.*" "Checking comments:" "no_newline_inline"  || true
}
# ============================================================================
# === USE FLAG SORT
# === sort_uses, sort_use_file.  Per-atom USE-list sort/dedup, last-state-wins
# === for repeated flags.  Used by -us/-uf/-s/-f.
# ============================================================================

# sort_uses: sort + dedupe USE flags per atom in $file (last-state-wins); preserve header + inline comments.
sort_uses(){
	tmp_file="$(_mktemp)"

	# Comment-preserving rewrite, same gawk approach as sort_uniq_files
	# plus the per-atom last-state-wins normalisation that used to live
	# in sort_passed_uses.  Inline trailing comments survive on their
	# atom line; whole-line `#` comments + blank lines form header
	# blocks that travel with their atom on sort; trailing comments at
	# EOF emit verbatim.  Atoms that resolve to no remaining USE flags
	# AND have no inline comment are dropped, taking their header with
	# them (matches the old bare-atom-drop semantics).
	awk '
		function resolve_uses(tokens,    a, n, i, j, base, last_state, ordering, bases, nb, tmp, out) {
			delete last_state
			delete ordering
			n = split(tokens, a, /[[:space:]]+/)
			for (i = 1; i <= n; i++) {
				if (a[i] == "") continue
				base = a[i]
				sub(/^-/, "", base)
				last_state[base] = a[i]
				ordering[base] = i
			}
			nb = 0
			for (base in ordering) bases[++nb] = base
			# Insertion sort by ordering value (ascending = first-seen first
			# in the result, matching the old sort_passed_uses output order).
			for (i = 2; i <= nb; i++) {
				tmp = bases[i]
				for (j = i; j > 1 && ordering[bases[j-1]] > ordering[tmp]; j--)
					bases[j] = bases[j-1]
				bases[j] = tmp
			}
			out = ""
			for (i = 1; i <= nb; i++)
				out = (out == "" ? last_state[bases[i]] : out " " last_state[bases[i]])
			return out
		}

		/^[[:space:]]*$|^[[:space:]]*#/ {
			pending_header = pending_header $0 "\n"
			next
		}

		{
			atom = $1
			rest = substr($0, length($1) + 1)
			sub(/^[[:space:]]+/, "", rest)

			# Detect trailing inline comment ("...flags # text").
			inline_comment = ""
			if (match(rest, /[[:space:]]+#/) > 0) {
				# RSTART = leading whitespace, RLENGTH = ws + 1 for the `#`.
				inline_comment = substr(rest, RSTART + RLENGTH - 1)
				rest = substr(rest, 1, RSTART - 1)
			}

			if (!(atom in atoms)) {
				atoms[atom] = rest
				inline_comments[atom] = inline_comment
				headers[atom] = pending_header
			} else {
				atoms[atom] = (atoms[atom] == "" ? rest : atoms[atom] " " rest)
				if (inline_comments[atom] == "") inline_comments[atom] = inline_comment
			}
			pending_header = ""
		}

		END {
			n = asorti(atoms, sorted)
			for (i = 1; i <= n; i++) {
				a = sorted[i]
				resolved = resolve_uses(atoms[a])
				if (resolved == "" && inline_comments[a] == "")
					continue   # drop bare atom and its header
				if (resolved == "")
					printf "%s%s %s\n", headers[a], a, inline_comments[a]
				else if (inline_comments[a] == "")
					printf "%s%s %s\n", headers[a], a, resolved
				else
					printf "%s%s %s %s\n", headers[a], a, resolved, inline_comments[a]
			}
			if (pending_header != "") printf "%s", pending_header
		}
	' "${file}" > "${tmp_file}"

	diff_ask "${file}" "${tmp_file}"
	eend $? 2>/dev/null
}
# sort_use_file: walker — sort_uses applied across every package.use entry.
sort_use_file(){
	file_or_dir "package.use" "Sorting use flags in" "set -f" "sort_uses" "set +f" || true
}
# ============================================================================
# === KEYWORDS
# === stupid_keywords, sort_keys, sort_keywords, uniq_keywords.
# === package.accept_keywords / package.keywords sort + dedup.  Used by
# === -ku/-ko/-s/-f.
# ============================================================================

# stupid_keywords: remove per-package keywords that already match the system ACCEPT_KEYWORDS or a wildcard parent entry.
stupid_keywords(){
	unset ACCEPT_KEYWORDS
	local ACCEPT_KEYWORDS
	ACCEPT_KEYWORDS="$(eix --print ACCEPT_KEYWORDS)"
	for KEY in ${ACCEPT_KEYWORDS};do
		while read satom lkeys;do
			comment="$(cut -d\# -f2- <<< "${lkeys}")"
			lkeys="${lkeys%%#*}"
			lkeys="${lkeys%% }"
			out_keys="$(tr ' ' $'\n' <<< "${lkeys}")"
			#### wildcards
			pcategory="${satom%%/*}"
			pcategory="$(tr -d "<>=~" <<< "${pcategory}")"
			parent_keys="$(grep -e "${pcategory}/\*" -e "\*/\*" "${1}" | sed 's|^.* ||' | sort -u || true)"
			#### /wildcards
			if [[ "${satom}" != "${pcategory}/*" && "${satom}" != "*/*" ]];then
				for key in ${lkeys};do
					for pkey in ${parent_keys};do
						if [[ "${key}" == "${KEY}" || ${key} == "${pkey}" ]];then
							printf '%b\n' "Twice defined keyword ${red}${key}${restore}:\t${green}${satom}${restore}"
							out_keys="$(grep -v "$(printf '%s' "${key}")"  <<< "${out_keys}" || true)"
						fi
					done
				done
			fi
			out_keys="$(tr $'\n' ' ' <<< "${out_keys}")"
			out_keys="${out_keys% }"
			if [[ "${lkeys}" != "${out_keys}" ]];then
				if [[ -n "${out_keys% }" ]];then
					if [[ -n "${comment}" ]];then
						string="$(grep "^${satom} ${lkeys} .*#${comment}$" "${1}" || true)"
						fixed_string="${satom} ${out_keys% } #${comment}"
					else
						string="$(grep "^${satom} ${lkeys}$" "${1}" || true)"
						fixed_string="${satom} ${out_keys}"
					fi
				else
					string="$(grep "^${satom} ${lkeys}.*$" "${1}" || true)"
					fixed_string=""
				fi
				sed -e "s|^${string//\*/\\*}$|${fixed_string}|"  -e '/^$/d' -i "${2}" || echo fail 525
			fi
		done < "${1}"
	done
}
# sort_keys: for each atom in $file, sort + dedupe its keyword list (last-state-wins); fill empty to ~$ARCH; preserve header + inline comments.
sort_keys(){
	tmp_file="$(_mktemp)"
	striped="$(_mktemp)"

	# Same gawk approach as sort_uses, two differences: (a) keyword
	# bases strip ~ as well as - (e.g. amd64 / -amd64 / ~amd64 share
	# base "amd64"); (b) atoms whose keyword list resolves to empty
	# default to ~$ARCH (matches the legacy `${keys:-"~${ARCH}"}`
	# fallback); never dropped.  Header blocks travel with their atom
	# on sort; trailing comments emit verbatim at EOF.
	awk -v arch="${ARCH}" '
		function resolve_keys(tokens,    a, n, i, j, base, last_state, ordering, bases, nb, tmp, out) {
			delete last_state
			delete ordering
			n = split(tokens, a, /[[:space:]]+/)
			for (i = 1; i <= n; i++) {
				if (a[i] == "") continue
				base = a[i]
				sub(/^[~-]/, "", base)
				last_state[base] = a[i]
				ordering[base] = i
			}
			nb = 0
			for (base in ordering) bases[++nb] = base
			for (i = 2; i <= nb; i++) {
				tmp = bases[i]
				for (j = i; j > 1 && ordering[bases[j-1]] > ordering[tmp]; j--)
					bases[j] = bases[j-1]
				bases[j] = tmp
			}
			out = ""
			for (i = 1; i <= nb; i++)
				out = (out == "" ? last_state[bases[i]] : out " " last_state[bases[i]])
			return out
		}

		/^[[:space:]]*$|^[[:space:]]*#/ {
			pending_header = pending_header $0 "\n"
			next
		}

		{
			atom = $1
			rest = substr($0, length($1) + 1)
			sub(/^[[:space:]]+/, "", rest)
			inline_comment = ""
			if (match(rest, /[[:space:]]+#/) > 0) {
				inline_comment = substr(rest, RSTART + RLENGTH - 1)
				rest = substr(rest, 1, RSTART - 1)
			}
			if (!(atom in atoms)) {
				atoms[atom] = rest
				inline_comments[atom] = inline_comment
				headers[atom] = pending_header
			} else {
				atoms[atom] = (atoms[atom] == "" ? rest : atoms[atom] " " rest)
				if (inline_comments[atom] == "") inline_comments[atom] = inline_comment
			}
			pending_header = ""
		}

		END {
			n = asorti(atoms, sorted)
			for (i = 1; i <= n; i++) {
				a = sorted[i]
				resolved = resolve_keys(atoms[a])
				if (resolved == "") resolved = "~" arch
				if (inline_comments[a] == "")
					printf "%s%s %s\n", headers[a], a, resolved
				else
					printf "%s%s %s %s\n", headers[a], a, resolved, inline_comments[a]
			}
			if (pending_header != "") printf "%s", pending_header
		}
	' "${file}" > "${striped}"

	cp "${striped}" "${tmp_file}"
	stupid_keywords "${tmp_file}" "${striped}"
	rm "${tmp_file}" 2>/dev/null
	diff_ask "${file}" "${striped}"
	eend $? 2>/dev/null
}
# sort_keywords: keep only the most-recent single keyword per atom (last token wins); preserve header + inline comments.
sort_keywords(){
	keys(){
		tmp_file="$(_mktemp)"
		striped="$(_mktemp)"

		# Same shape as sort_keys but per-atom keyword resolution
		# differs: keep ONLY the absolute last token (across all
		# duplicate atom lines), not last-state-per-base.  Empty
		# default to ~$ARCH.  Inline comment + header carry from
		# the first occurrence.
		awk -v arch="${ARCH}" '
			/^[[:space:]]*$|^[[:space:]]*#/ {
				pending_header = pending_header $0 "\n"
				next
			}
			{
				atom = $1
				rest = substr($0, length($1) + 1)
				sub(/^[[:space:]]+/, "", rest)
				inline_comment = ""
				if (match(rest, /[[:space:]]+#/) > 0) {
					inline_comment = substr(rest, RSTART + RLENGTH - 1)
					rest = substr(rest, 1, RSTART - 1)
				}
				# Last token only (across all flag tokens on this line).
				n = split(rest, tokens, /[[:space:]]+/)
				last = ""
				for (i = n; i >= 1; i--) {
					if (tokens[i] != "") { last = tokens[i]; break }
				}
				if (!(atom in atoms)) {
					headers[atom] = pending_header
					inline_comments[atom] = inline_comment
				}
				atoms[atom] = last    # always overwrite — last occurrence wins
				pending_header = ""
			}
			END {
				n = asorti(atoms, sorted)
				for (i = 1; i <= n; i++) {
					a = sorted[i]
					keyword = (atoms[a] == "" ? "~" arch : atoms[a])
					if (inline_comments[a] == "")
						printf "%s%s %s\n", headers[a], a, keyword
					else
						printf "%s%s %s %s\n", headers[a], a, keyword, inline_comments[a]
				}
				if (pending_header != "") printf "%s", pending_header
			}
		' "${file}" > "${striped}"

		cp "${striped}" "${tmp_file}"
		stupid_keywords "${tmp_file}" "${striped}"
		rm "${tmp_file}" 2>/dev/null
		diff_ask "${file}" "${striped}"
		eend $? 2>/dev/null
	}
	file_or_dir "package.keywords package.accept_keywords" "Sorting keywords in" "keys" || true
}
# uniq_keywords: sort + dedupe keyword entries across every package.keywords and package.accept_keywords file.
uniq_keywords(){
	file_or_dir "package.keywords package.accept_keywords" "Sorting keywords in" "set -f" "sort_keys" "set +f" || true
}
# ============================================================================
# === INSTALL-STATE FILTERS
# === installed, not_if, force_not_installed.  Filter atoms against $PKGDB;
# === backbone of -t/-ft.
# ============================================================================

# installed: probe — set $installed to the qlist output if $category/$pn is installed, else "".
installed(){
	all_vers=""
	installed="$(qlist -ICSec "${category}/${pn}" | awk '{print $2}' || true)"
	if [[ -n "${installed}" ]];then
		# Note: installed_vers / installed_min_ver / installed_max_ver /
		# installed_live_ver were computed here historically but never
		# referenced downstream.  Removed during the 2.0.0 cosmetic pass
		# (shellcheck SC2034).  Only installed_slots is used below.
		installed_slots="$(awk -F \: '{print $2}' <<< "${installed}")"
		#::repo check
		full_vers="$(qlist -ICev "${category}/${pn}" | sed "s|${category}/${pn}-||g")"
		if [[ -n "${defined_repo}" ]];then
			for ver in ${full_vers};do
				all_vers+=" ${PKGDB}/${category}/${pn}-${ver}/repository"
			done
			grep -qe "^${defined_repo}$" ${all_vers} || installed=""
			unset all_vers
		fi
		[[ "${installed_slots}" == "0" ]] && unset installed_slots
	fi
	# Sets $installed for the caller; never let the last [[ ]]'s exit leak
	# (a false test would abort `installed;` under set -e).
	return 0
}

# not_if: remove atoms in $package whose target package is NOT installed (keep installed ones).
not_if(){
	atoms="$(awk '{print $1}' <<< "$(grep -v "^#" < "${package}")" || true)"
	[[ -n "${IGNORE}" ]] && atoms="$(grep -v "${IGNORE}" <<< "${atoms}" || true)"
	printf '%b\n' "${underline}Checking${restore} ${contrast}$package${restore}"
	if [[ -n "${atoms}" ]];then
		while read atom;do
			#::repo check
			if grep -q "::" <<< "${atom}";then
				defined_repo="${atom##*::}"
			else
				defined_repo=""
			fi
			[[ -n "${defined_repo}" ]] && atom="${atom%%::${defined_repo}}"
			while read category pn ver rev slot;do
				sw="$(grep -o "[<>=~]" <<< "${category}" | tr -d $'\n' || true)"
				category="${category##${sw}}"

				[[ "${category}" == "(null)" || "${pn}" == "(null)" ]] && continue

				if [[ -n "${rev}" ]] && [[ -z "${slot}" ]] && grep -q \: <<< "${rev}";then
					slot="${rev}"
					unset rev
				fi
				slot="${slot#:}"
				pn="${pn%:}"
				installed;

				if [[ -z "${installed}" ]];then
					if [[ -n "${defined_repo}" ]];then
						printf '%b\n' "${red}Not installed${restore} ${green}${category}/${pn}::${underline}${defined_repo}${restore}"
					else
						printf '%b\n' "${red}Not installed${restore} ${green}${category}/${pn}${restore}"
					fi
					# Escape category/pn before sed interpolation.  Atom
					# parts from qatom are constrained (no `|`/`*`/`[`)
					# but `.` shows up in atoms with x.y-style component
					# names (`gtk2.0`, etc.) and would silently misalign.
					local _cp
					_cp="$(_sed_escape_pat "${category}/${pn}")"
					sed -e "s|.*\<${_cp}\>.*||" -e '/^$/d' -i "${tmp_package}" 2>/dev/null || true
					eend $? 2>/dev/null
					unset _cp
				fi
			done <<< "$(qatom "${atom}")"
		done <<< "${atoms}"
	fi
}

# force_not_installed: walk every package.* file under $PORT_ETC (excl. .mask) calling not_if; drop empty files.
force_not_installed(){
	while IFS= read -r package; do
		if [[ -s "${package}" && -n "$(grep -v "^#" < "${package}" || true)" ]];then
			tmp_package="$(_mktemp)"
			cp "${package}" "${tmp_package}"
			if ! grep -q "\.mask" <<< "${package}";then
				not_if;
				eend $? 2>/dev/null
			fi
			diff_ask "${package}" "${tmp_package}"
		else
			pack="${package%/*}"
			printf '%b\n' "${underline}Empty file${restore} ${contrast}${pack}${restore}"
			remove_ask "${package}"
			eend $? 2>/dev/null
		fi
	done < <(find "${PORT_ETC}"/package* -type f \! -name '*~' \! -name '*.bak')

	while IFS= read -r x; do
		if [[ ! -s "${x}" ]];then
			printf '%b\n' "${underline}Empty file${restore} ${contrast}${x}${restore}"
			remove_ask "${x}"
			eend $? 2>/dev/null
		fi
	done < <(find "${PORT_ETC}"/package* -type f)
}
# ============================================================================
# === PACKAGE.ENV
# === package_env_conf, package_env, env_not_installed.  Cleanup of
# === $PORT_ETC/package.env entries and the env/ subdir files they reference.
# ============================================================================

# package_env_conf: remove env/ conf files no longer referenced by any package.env entry.
package_env_conf(){
	# `find` exits 1 if ${PORT_ETC}/env doesn't exist (common: most users
	# never use per-package env), and command substitution propagates that
	# failure to the assignment under set -e — script exits 1 mid-dispatch.
	# Silence and force success; empty output means "no env confs".
	all_confs="$(find "${PORT_ETC}/env/" -maxdepth 1 -type f 2>/dev/null || true)"
	all_confs="${all_confs//${PORT_ETC////\/}\/env\//}"
	check_env_conf(){
		USED_ENV=""
		atoms="$(sed 's/^[ \t]*//;s/[ \t]*$//;/^#/d;/^$/d;' < "${file}" | awk '{print $1}')"
		while IFS= read -r line;do
			line="$(sed 's/^[ \t]*//;s/[ \t]*$//' <<< "${line%%#*}")"
			for atom in ${atoms};do
				USED_ENV+=" ${line#${atom} }"
			done
		done < "${file}"
		USED_ENV="$(tr ' ' $'\n' <<< "${USED_ENV}")"
		for conf in ${all_confs};do
			if ! grep -q "^${conf}$" <<< "${USED_ENV}";then
				printf '%b\n' "Unused conf: ${red}${conf}${restore}"
				remove_ask "${PORT_ETC}/env/${conf}"
				eend $? 2>/dev/null
			fi
		done
	}
	file_or_dir "package.env" "Checking unused configs in" "check_env_conf" || true
}
# package_env: remove package.env conf references whose env/ file doesn't exist on disk.
package_env(){
	package_env_def(){
		tmp_file="$(_mktemp)"
		cp "${file}" "${tmp_file}"
		while IFS= read -r line;do
			xline="$(sed 's/^[ \t]*//;s/[ \t]*$//' <<< "${line%%#*}")"
			atom="${xline%% *}"
			all_confs="${xline#${atom} }"
			for conf in ${all_confs};do
				if [[ -f "${PORT_ETC}/env/${conf}" ]];then
					IGNORE+=$'\n'"${conf}"
				else
					printf '%b\n' "Defined conf not exists: ${red}${conf}${restore}"
					new_line=$(grep -v "^${conf}$" <<< "$(tr ' ' $'\n' <<< "${line}")" | tr $'\n' ' ' || true)
					new_line="$(sed 's/^[ \t]*//;s/[ \t]*$//' <<< "${new_line}")"
					# Escape sed metacharacters before interpolating user-
					# controlled content from package.env into the s|||
					# pattern.  Without this, lines containing `|`, `\`,
					# `.`, `[`, `*`, `&` corrupt or silently break the
					# in-place edit.  Atoms with USE-dep brackets like
					# `sys-apps/grep[static]` are the most common trigger.
					_p="${line//\\/\\\\}";     _p="${_p//|/\\|}"
					_p="${_p//./\\.}";         _p="${_p//\[/\\[}"
					_p="${_p//\*/\\*}"
					_r="${new_line//\\/\\\\}"; _r="${_r//|/\\|}"
					_r="${_r//&/\\&}"
					sed "s|${_p}|${_r}|" -i "${tmp_file}"
					unset _p _r
					line="${new_line}"
				fi
			done
		done < "${file}"
		diff_ask "${file}" "${tmp_file}"
		eend $? 2>/dev/null
	}
	file_or_dir "package.env" "Checking defined configs in" "package_env_def" || true
}
# env_not_installed: remove env/<cat>/<pn> files whose target package is not installed.
env_not_installed(){
	RM=""
	printf '%b\n' "${underline}Looking not installed in${restore} ${contrast}${PORT_ETC}/env${restore}"
	for x in "env" "env.d";do
		files="$(find "${PORT_ETC}/${x}/" -mindepth 2 -maxdepth 2 -type f \! -name '*~' \! -name '*.bak' 2>/dev/null | cut -d\/ -f5- || true)"
		[[ -n "${IGNORE}" ]] && files="$(grep -v "${IGNORE}" <<< "${files}" || true)"
		dirs="$(find "${PORT_ETC}/${x}/" -type d 2>/dev/null || true)"
		[[ -n "${IGNORE}" ]] && dirs="$(grep -v "${IGNORE}" <<< "${dirs}" || true)"
		[[ -n "${files}" || -n "${dirs}" ]] || break

		while read file;do
			atom="$(qatom "${file}")"
			atom="$(sed -e '/^$/d' <<< "${atom}")"
			while read category pn ver rev slot;do
				[[ "${category}" == "(null)" || "${pn}" == "(null)" ]] && continue
				[[ "${ver}" == "(null)" ]] && ver="${ver//(null)/}"
				if [[ -n "${rev}" ]] && ! grep -q \: <<< "${rev}";then
					full_ver="${ver}-${rev}"
				else
					full_ver="${ver}"
				fi

				[[ -n "${rev}" && -z "${slot}" ]] && grep -q \: <<< "${rev}" && slot="${rev}"
				slot="${slot#:}"

				if [[ -z "${ver}" && -z "${slot}" ]];then
					if ! ls -d1 "${PKGDB}/${category}/${pn}"-[0-9]* &>/dev/null;then
						printf '%b\n' "${red}Not installed${restore} ${green}${category}/${pn}${restore}"
						RM+="${PORT_ETC}/${x}/${file}%"
						eend $? 2>/dev/null
					fi
				fi

				if [[ -n "${ver}" && -z "${slot}" ]] ;then
					if ! ls -d1 "${PKGDB}/${category}/${pn}-${full_ver}" &>/dev/null;then
						printf '%b\n' "${red}Not installed${restore} ${green}${category}/${pn}-${full_ver}${restore}"
						RM+="${PORT_ETC}/${x}/${file}%"
						eend $? 2>/dev/null
					fi
				fi

				if [[ -z "${ver}" && -n "${slot}" ]] ;then
					if [[ -z "$(cat "${PKGDB}/${category}/${pn}"-[0-9]*/SLOT 2>/dev/null | grep "${slot}" || true)" ]];then
						printf '%b\n' "${red}Not installed${restore} ${green}${category}/${pn}:${slot}${restore}"
						RM+="${PORT_ETC}/${x}/${file}%"
						eend $? 2>/dev/null
					fi
				fi
			done <<< "${atom}"
		done <<< "${files}"

		while IFS='%' read -r target; do
			[[ -z "${target}" ]] && continue
			remove_ask "${target}"
		done <<< "${RM%\%}"
		while IFS= read -r target; do
			[[ -z "$(ls "${target}")" ]] && remove_ask "${target}"
		done <<< "${dirs}"
	done
	eend $? 2>/dev/null
}
# ============================================================================
# === USE FLAG ANALYSIS
# === invalid_uses, make_conf_use, hell_parser, invalid_uses_make.
# === Detects invalid/redundant USE flags against eix metadata.  Heavy
# === sed/agrep pipeline; see HIGH#1 in ChangeLog for the sed-injection fix.
# ============================================================================

# invalid_uses: remove invalid or redundant USE flags from package.use against eix metadata.
invalid_uses(){
	# `local -` (bash 4.4+) snapshots the current shell-option state and
	# restores it on function return, no matter how we exit (normal, set
	# -e abort, explicit return).  Pairs the `set -f` below — without it,
	# an early return inside this 170-line function would leave globbing
	# disabled for every subsequent dispatch step.
	local -
	set -f
	incorrect_use=""
	global_use=""
	GLOBAL=""
	FULL="${PROFILE} ${MAKE_USES}"
	for opt in ${FULL};do
		GLOBAL+=" $(echo ${FULL} | tr "[:space:]" $'\n' | grep -e "^${opt#-}$" -e "^-${opt#-}$" | tail -n1 || true)"
	done
	GLOBAL="$(echo ${GLOBAL} | tr "[:space:]" $'\n' | sort -u)"
	check_uses(){
		printf '%b\n' "${underline}Checking use flags in${restore} ${contrast}${file#${PORT_ETC}/}${restore}:"
		##### eix env #####
		export OVERLAYS_LIST="no"
		export FORMAT='<availableversions:USEONLY>'
		export USEONLY=' <colliuse>'
		#### just count
		prepare(){
			while IFS= read -r string;do
				struse="${string#${category}/${pn}}"
				struse="$(tr "[:space:]" $'\n' <<< "${struse}")"
				usefxd="$(sed -e "s|^${trash#-}$||" -e "s|^\-${trash#-}$||" -e '/^$/d' <<< "${struse}")"
				usefxd="$(tr $'\n' " " <<< "${usefxd}")"
				usefxd="$(sed -e 's| - | |g' -e 's/[ -]*$//' <<< "${usefxd}")"
				strfxd="${category}/${pn} ${usefxd}"
				sed -e "s|^${category}/${pn}[[:space:]].*${trash#-}.*|$strfxd|" -i "${tmp_file}" 2>/dev/null || true
				eend $? 2>/dev/null
			done <<< "${strings}"
		}

		_tput sc
		_tput civis
		while read category pn ver slot;do
			_tput el
			_tput el1
			printf '['; printf "% ${chars}d" $((count--)); printf ' ] atoms left' 2>/dev/null
			_tput rc

			ALL_USE=" $(eix -e "${category}/${pn}")" || continue
			ALL_USE="$(sed -e 's| +| |g;s| -| |g;s|(+)||g;s|(-)||g' <<< "${ALL_USE}" | tr "[:space:]" $'\n' | sort -u | sed -e '/^$/d')"
			LOCAL="$(grep "\<${category}/${pn}\> " "${file}" | cut -d" " -f2- | sed -e "s|#.*||g" | tr "[:space:]" $'\n' | sort -u || true)"
			USES="$(sed -e 's|^-||g' <<< "${LOCAL}")"
			for use in ${USES};do
				if ! grep -q "^${use}$" <<< "${ALL_USE}" && [[ "${use}" != "*" ]];then
					# Invalid flag (not in the package's IUSE): mark it for
					# removal.  An earlier agrep edit-distance "did you mean"
					# correction lived here, but on real configs it mis-mapped
					# genuinely-removed flags to unrelated valid ones
					# (gles1->test, xvmc->llvm, pipe->zip, ...) and duplicated
					# the target, corrupting package.use.  -ui REMOVES invalid
					# flags per the man page, so that is all we do.
					grep -q " ${use}\>" <<< "${incorrect_use}" || incorrect_use="${incorrect_use} ${use}"
				else
					incorrect_use="${incorrect_use// ${use}/}"
				fi

				if grep -q "^${use}$" <<< "${GLOBAL}" && grep -q "^${use}$" <<< "${LOCAL}";then
					global_use="${global_use} ${use}"
				elif grep -q "^-${use}$" <<< "${GLOBAL}" && grep -q "^-${use}$" <<< "${LOCAL}";then
					global_use="${global_use} -${use}"
					incorrect_use="${incorrect_use// ${use}/}"
				fi
			done

			incorrect_use="$(echo ${incorrect_use} | tr "[:space:]" $'\n' | sed -e 's|  | |g' -e '/^ $/d' -e '/^$/d' | sort -u)"
			global_use="$(echo ${global_use} | tr "[:space:]" $'\n' | sed -e 's|  | |g' -e '/^ $/d' -e '/^$/d' | sort -u)"
			if [[ -n "${incorrect_use}" ]];then
				while read trash;do
					printf '%b\n' "Invalid use: ${green}${category}/${pn}${restore}: ${red}${trash}${restore}"
					strings="$(grep "^${category}/${pn}[[:space:]].*\<${trash}\>" ${tmp_file} || true)"
					prepare;
				done <<< "${incorrect_use}"
			fi
			if [[ -n "${global_use}" ]];then
				while read trash;do
					printf '%b\n' "Global  use: ${green}${category}/${pn}${restore}: ${red}${trash}${restore}"
					strings="$(grep "^${category}/${pn}[[:space:]].*\<${trash#-}\>" ${tmp_file} || true)"
					prepare;
				done <<< "${global_use}"
			fi
			unset ALL_USE LOCAL USES use
			incorrect_use="" global_use=""
		done <<< "$([[ -n "${atoms}" ]] && printf '%b\n' "${atoms}")"

		# Bare-atom cleanup.  After prepare() strips invalid/global USE
		# flags, some lines collapse to "${atom}" alone (no flags).
		# Drop each such line AND its preceding header block (the
		# consecutive comment + blank lines immediately above it),
		# otherwise the explanatory comments orphan: their atom is
		# gone but their annotation stays.  Single awk pass over the
		# post-strip tmp_file replaces the previous two sed-driven
		# loops (one over $file, one over $tmp_file) — checking the
		# tmp_file alone catches both the user-written-bare and the
		# prepare-made-bare cases.
		# NF==1 AND not a comment — a comment-only line `#single-token` would
		# also be NF==1 but isn't a bare atom; exclude via the regex.
		_bare_atoms="$(awk 'NF == 1 && !/^[[:space:]]*#/ { print $1 }' "${tmp_file}")"
		if [[ -n "${_bare_atoms}" ]]; then
			while IFS= read -r _atom; do
				[[ -z "${_atom}" ]] && continue
				printf '%b\n' "Removing atom: ${green}${_atom}${restore}"
				eend 0 2>/dev/null
			done <<< "${_bare_atoms}"
			awk '
				/^[[:space:]]*$|^[[:space:]]*#/ { pending = pending $0 "\n"; next }
				NF == 1 { pending = ""; next }
				{ printf "%s%s\n", pending, $0; pending = "" }
				END { if (pending != "") printf "%s", pending }
			' "${tmp_file}" > "${tmp_file}.new"
			mv "${tmp_file}.new" "${tmp_file}"
		fi
		unset _bare_atoms _atom
		eend $? 2>/dev/null
		unset FORMAT USEONLY
	}
	if [[ -f "${PORT_ETC}/package.use" ]];then
		file="${PORT_ETC}/package.use"
		tmp_file="$(_mktemp)"
		cp "${file}" "${tmp_file}"
		atoms=""
		if [[ -n "${IGNORE}" ]];then
			content="$(awk '{print $1}' "${file}" | tr -d "<>=~" | sed -e 's|^#.*||g' | grep -v "${IGNORE}" || true)"
			[[ -n "${content}" ]] && atoms="$(qatom ${content})"
		else
			content="$(awk '{print $1}' "${file}" | tr -d "<>=~" | sed -e 's|^#.*||g')"
			[[ -n "${content}" ]] && atoms="$(qatom ${content})"
		fi
		count="$(wc -l <<< "${atoms}")"
		((count--))
		chars="$(wc -m <<< "${count}")"
		check_uses;
		_tput el;
		_tput cnorm;
		diff_ask "${file}" "${tmp_file}"
		[[ ! -s "${file}" ]] && remove_ask "${file}"
	elif [[ -d "${PORT_ETC}/package.use" ]];then
		while IFS= read -r f; do
			if [[ -s "${f}" ]];then
				file="${f}"
				tmp_file="$(_mktemp)"
				cp "${file}" "${tmp_file}"
				atoms=""
				if [[ -n "${IGNORE}" ]];then
					content="$(awk '{print $1}' "${file}" | tr -d "<>=~" | sed -e 's|^#.*||g' | grep -v "${IGNORE}" || true)"
					[[ -n "${content}" ]] && atoms="$(qatom ${content})"
				else
					content="$(awk '{print $1}' "${file}" | tr -d "<>=~" | sed -e 's|^#.*||g')"
					[[ -n "${content}" ]] && atoms="$(qatom ${content})"
				fi
				count="$(wc -l <<< "${atoms}")"
				((count--))
				chars="$(wc -m <<< "${count}")"
				check_uses;
				_tput cnorm
				diff_ask "${file}" "${tmp_file}"
				[[ ! -s "${file}" ]] && remove_ask "${file}"
			else
				printf '%b\n' "${underline}Removing empty file${restore} ${contrast}${f}${restore}"
				rm "${f}" 2>/dev/null
				eend $? 2>/dev/null
				continue
			fi
		done < <(find "${PORT_ETC}/package.use/" -type f \! -name '*~' \! -name '*.bak')
	fi
	_tput cnorm
	# `local -` at function entry restores set -f state on return.
}
# make_conf_use: emit make.conf's NAME="..." assignment line (single- or multi-line form).
make_conf_use() {
	defined_flags="$(grep "${1}=\".*\"" "${makefile}" || true)"
	defined_flags="${defined_flags:-"$(sed -ne "/${1}=\"/,/\"/p" "${makefile}")"}"
	echo "${defined_flags}"
}

# hell_parser: parse a NAME="v1 v2 \<cont>" assignment (one- or multi-line) into one value per line, stripping leading `-`.
hell_parser(){
	sed -e 's|[[:space:]]| |g' -e :a -e '/\\$/N; s/\\\n//; ta' | \
	cut -d\" -f2 | tr "[[:space:]]" $'\n' | sed '/^$/d;s|^-||g'  | sort -u
}

# invalid_uses_make: remove USE flags from make.conf not present in any known IUSE (per `eix --print-all-useflags`).
invalid_uses_make(){
	invalid_uses=""
	# No make.conf → ${makefile} is empty; skip rather than `cp ""` + abort.
	[[ -n "${makefile}" ]] || return 0
	# See invalid_uses for the `local -` rationale.
	local -
	set -f
	printf '%b\n' "${underline}Checking use flags in${restore} ${contrast}${makefile}${restore}"
	tmp_file="$(_mktemp)"
	cp "${makefile}" "${tmp_file}"

	vars_in_USE="$(make_conf_use USE | hell_parser | grep '\$' | tr -d '${}' || true)"
	real_uses="$(eix --print-all-useflags | sed 's|^[-+]||g;s|^(+)||g' | sort -u)"
	for var in ${vars_in_USE} USE;do
		sub_uses="$(make_conf_use ${var} | hell_parser | grep -v '\$' || true)"
		for use in ${sub_uses};do
			if ! grep -q "^${use}$" <<< "${real_uses}" && [[ "${use}" != "*" ]];then
				printf '%b' "Invalid use ${contrast} ${var}: ${red}${use}${restore}" | column -t
				invalid_uses+=" ${use}"
			fi
		done
	done

	if [[ -n "${invalid_uses}" ]];then
		for iuse in ${invalid_uses};do
			line="$(grep "\<${iuse}\>" "${tmp_file}" || true)"
			[[ -z "${line}" ]] && continue
			fixed_line="$(sed "s|[- \t]${iuse}||" <<< "${line}")"
			if [[ "${line}" != "${fixed_line}" ]]; then
				_p="${line%\\}";    _p="${_p//\\/\\\\}"; _p="${_p//|/\\|}"; _p="${_p//./\\.}"
				_r="${fixed_line%\\}"; _r="${_r//\\/\\\\}"; _r="${_r//|/\\|}"; _r="${_r//&/\\&}"
				sed -e "s|${_p}|${_r}|" -i "${tmp_file}"
				unset _p _r
			fi
		done
	fi
	diff_ask "${makefile}" "${tmp_file}"
	# `local -` at function entry restores set -f state on return.
}
# ============================================================================
# === ATOM VALIDATION
# === not_found.  Detects atoms that no longer match any ebuild
# === (renamed/removed upstream).  Used by -t/-ft/-f.
# ============================================================================

# not_found: remove atoms in package.* that no longer match any ebuild.
not_found(){
	INVALID_FOUNDED=""
	printf '%b\n' "${underline}Checking invalid entries${restore}..."
	TRASH="$(LANG=en eix -Ttc 2>/dev/null || true)"
	while IFS= read -r package; do
		incorrect="$(printf '%b\n' "${TRASH}" | tr $'\n' "%" | sed -e "s|.*${package}:||" -e 's|--.*||' -e 's|No.*||'|\
		tr "%" $'\n' | sed -e '/^$/d' | grep -v "${IGNORE}" || true)"
		if [[ -n "${incorrect}" && -f "${package}" ]];then
			tmp_package="$(_mktemp)"
			cp "${package}" "${tmp_package}"
			printf '%b\n' "${underline}Removing incorrect from${restore} ${contrast}${package}${restore}:"
			while IFS= read -r line;do
				printf '%b\n' "${red}Incorrect:${restore} ${line}"
				[[ -n "${line}" ]] && _drop_line "${tmp_package}" "${line}" field1
				eend $? 2>/dev/null
			done <<< "${incorrect}"
			diff_ask "${package}" "${tmp_package}"
		elif [[ -n "${incorrect}" && -d "${package}" ]];then
			printf '%b\n' "${underline}Removing incorrect from${restore} ${contrast}${package}${restore}:"
			while IFS= read -r line; do
				while IFS= read -r file; do
					tmp_file="$(_mktemp)"
					cp "${file}" "${tmp_file}"
					printf '%b\n' "${red}Incorrect:${restore} ${line}"
					[[ -n "${line}" ]] && _drop_line "${tmp_file}" "${line}" field1
					diff_ask "${file}" "${tmp_file}"
					eend $? 2>/dev/null
				done < <(grep -RH "${line//'*'/\*}" "${package}"/ | awk -F \: '{print $1}')
			done <<< "${incorrect}"
		fi
	done < <(
		for package in "${PORT_ETC}"/package*; do
			[[ -e "${package}" ]] || continue
			case "${package}" in *~|*.bak|*.old) continue;; esac
			printf '%s\n' "${package}"
		done
	)

	INVALID="$(LANG=en eix -Ttc 2>&1 | grep "Invalid.*\'.*\'" | grep -v '\.\.\.' | sort -u || true)"

	while IFS= read -r string; do
		[[ -z "${string}" ]] && continue
		file="$(awk -F ':' '{print $1}' <<< "${string}")"
		file="${file##* }"
		file="${file//[[:space:]]/}"

		line="$( awk -F ':' '{print $2}' <<< "${string}")"
		line="${line//\'/}"
		printf '%b\n' "${red}Incorrect:${restore} ${line}"
		line="${line#[[:space:]]}"
		INVALID_FOUNDED+="${line}"$'\n'

		if [[ -n "${line}" && -f "${file}" ]];then
			tmp_file="$(_mktemp)"
			cp "${file}" "${tmp_file}"
			[[ -n "${line}" ]] && _drop_line "${tmp_file}" "${line}" field1
			diff_ask "${file}" "${tmp_file}"
		elif [[ -n "${line}" && -d "${file}" ]];then
			while IFS= read -r package; do
					tmp_package="$(_mktemp)"
					cp "${package}" "${tmp_package}"
					printf '%b\n' "${red}Incorrect:${restore} ${line}"
					[[ -n "${line}" ]] && _drop_line "${tmp_package}" "${line}" field1
					diff_ask "${package}" "${tmp_package}"
					eend $? 2>/dev/null
			done < <(grep -RH "${line//'*'/\*}" "${file}"/ | awk -F \: '{print $1}')
		fi
		eend $? 2>/dev/null
	done <<< "${INVALID}"

	##### don't quote it! #####
	if [[ -n "${INVALID_FOUNDED}" ]];then
		invalid=$(emerge --version 2>&1 | sed -e '/--- Invalid atom in /!d' -e 's|--- Invalid atom in ||g;s|:||' |\
			grep -v "${INVALID_FOUNDED}" || true)
	else
		invalid=$(emerge --version 2>&1 | sed -e '/--- Invalid atom in /!d' -e 's|--- Invalid atom in ||g;s|:||')
	fi
	broken_files="$(awk '{print $1}' <<< "${invalid}" | sort -u)"
	invalid_lines(){
		# Localise the set -f scope to this inner function via `local -`.
		# The `local` builtin keys off the enclosing function scope, so
		# even though this is nested inside not_found, the restoration
		# fires when invalid_lines returns (not when not_found returns).
		local -
		tmp_file="$(_mktemp)"
		cp "${file}" "${tmp_file}"
		set -f
		tlines="$(grep "^${file} " <<< "${invalid}" | sed "s|${file} ||g" || true)"
		while IFS= read -r line;do
			_drop_line "${tmp_file}" "${line}" field1
		done <<< "${tlines}"
		diff_ask "${file}" "${tmp_file}"
	}
	if [[ -n "${invalid}" ]];then
		for bad_file in ${broken_files};do
			file_or_dir "${bad_file#${PORT_ETC}/}" "Founded invalid lines in" "invalid_lines"
		done
	fi
	unset invalid broken_files
}
# ============================================================================
# === make.conf USE PRUNE
# === use_makeconf.  Removes USE flags from make.conf that are already
# === defined by the profile (the profile-shadow-in-make.conf case).
# === Used by -um/-uf/-f.
# ============================================================================

# use_makeconf: remove make.conf USE entries already defined by the profile (profile-shadow-in-make.conf cleanup).
use_makeconf(){
	# No make.conf → ${makefile} is empty; skip rather than `cp ""` + abort.
	[[ -n "${makefile}" ]] || return 0
	printf '%b\n' "${underline}Checking use flags in${restore} ${contrast}${makefile##/etc*/}${restore}"
	USE="$(printf '%b\n' "${MAKE_USES}" | tr "[:space:]" $'\n' | sort -u | sed -e '/^$/d')"

	tmp_file="$(_mktemp)"
	cp "${makefile}" "${tmp_file}"
	while read use;do
		flag="${use#-}"
		if [[ -n ${flag} ]];then
			if grep -q "^${flag}$" <<< "${USE}" && grep -q "^${flag}$" <<< "${PROFILE}";then
				printf '%b\n' "Twice defined: ${red}${use}${restore}"
				sed -e "s|[^[:punct:]]\<${flag}\>||g" -i "${tmp_file}"
			elif grep -q "^-${flag}$" <<< "${USE}" && grep -q "^-${flag}$" <<< "${PROFILE}";then
				printf '%b\n' "Twice defined: ${red}-${use}${restore}"
				sed -e "s|[^[:punct:]]\-\<${flag}\>||g" -i "${tmp_file}"
			fi
		fi
	done <<< "${PROFILE}"
	diff_ask "${makefile}" "${tmp_file}"
	eend $? 2>/dev/null
}
# ============================================================================
# === FILE MAINTENANCE
# === empty_files, backup_files, f_to_d, d_to_f.  Tidy operations: drop empty
# === files, drop *~ / .bak / .old backups, convert package.* files <-> dirs.
# ============================================================================

# empty_files: remove zero-byte and comments-only files anywhere under $PORT_ETC.
empty_files(){
	printf '%b\n' "${underline}Looking empty files${restore}"
	while IFS= read -r target; do
		[[ ! -s "${target}" || -z "$(grep -v "^#" < "${target}" || true)" ]] && remove_ask "${target}"
	# Only package.* config: a comments-only or empty make.conf / repos.conf is
	# legitimate and must never be auto-removed here (the old unfiltered find
	# flagged them for deletion).
	done < <(find "${PORT_ETC}" -type f -path '*/package.*')
	eend 0 2>/dev/null
}
# backup_files: remove editor backups (*~, *.bak, *.old) from $PORT_ETC.
backup_files(){
	printf '%b\n' "${underline}Looking backup files${restore}"
	while IFS= read -r target; do
		remove_ask "${target}"
	done < <(find "${PORT_ETC}" -type f \( -name "*~" -o  -name "*.bak" -o -name "*.old" \))
	eend 0 2>/dev/null
}
# f_to_d: convert package.* from flat-file to directory layout.
f_to_d(){
	# Guard the `set -f` inside the inner read loop below with `local -`
	# so a mid-loop early-exit doesn't leave globbing disabled for the
	# rest of the dispatch chain.
	local -
	while IFS= read -r package;do
		if [[ -f "${package}" ]];then
			printf '%b\n' "${underline}Processing${restore}: ${contrast}${package##*/}${restore}"
			tmp_file="$(_mktemp)"
			mv "${package}" "${tmp_file}" 2>/dev/null
			sed -e 's|^#.*||g' -i "${tmp_file}"
			dir="${PORT_ETC}/${package##*/}"
			mkdir "${dir}"
			set -f
			while read line;do
				atom="$(awk '{print $1}' <<< "${line}")"
				category="$(awk '{print $1}' <<< "$(qatom "${atom}")")"
				if [[ "${category}" != "(null)" ]];then
					category="$(tr -d "<>=~" <<< "${category}" )"
					[[ "${category}" == "*" ]] && category="all_categories"
					echo "${line}" >> "${dir}/${category}"
				fi
			done < "${tmp_file}"
			set +f
			eend $? 2>/dev/null
			rm "${tmp_file}" 2>/dev/null
		elif [[ -d "${package}" ]];then
			printf '%b\n' "${underline}Skipping ${red}directory${restore}: ${contrast}${package##*/}${restore}"
			eend $? 2>/dev/null
		fi
	done <<< "$(
		for package in "${PORT_ETC}"/package*; do
			[[ -e "${package}" ]] || continue
			[[ "${package}" == *~ ]] && continue
			printf '%s\n' "${package}"
		done
	)"
}
# d_to_f: convert package.* from directory layout back to flat-file.
d_to_f(){
	while IFS= read -r package;do
		if [[ -d "${package}" ]];then
			printf '%b\n' "${underline}Processing${restore}: ${contrast}${package##*/}${restore}"
			tmp_file="$(_mktemp)"
			file="${PORT_ETC}/${package##*/}"
			touch "${file}"
			while IFS= read -r subfile; do
				while read line;do
					echo "${line}" >> "${tmp_file}"
				done < "${subfile}"
			done < <(find "${package}" -type f \! -name '*~' \! -name '*.bak' | sort)
			rm -rf "${package}" 2>/dev/null
			mv "${tmp_file}" "${package}" 2>/dev/null
			chmod 0644 "${package}"
			eend $? 2>/dev/null
		elif [[ -f "${package}" ]];then
			printf '%b\n' "${underline}Skipping ${red}file${restore}: ${contrast}${package##*/}${restore}"
			eend $? 2>/dev/null
		fi
	done <<< "$(
		for package in "${PORT_ETC}"/package*; do
			[[ -e "${package}" ]] || continue
			[[ "${package}" == *~ ]] && continue
			printf '%s\n' "${package}"
		done
	)"
}
# ============================================================================
# === VERSION COMPARE
# === ver_diff, ver_btwn.  Atom version comparison helpers; used by mask_trash
# === to detect overlapping/redundant mask entries.
# ============================================================================

# ver_diff: echo 1 if $1>$2, 2 if $2>$1, 0 if equal (empty on parse failure).
ver_diff(){
	check="$(versionsort ${1} ${2} 2>/dev/null | tail -n1)"
	[[ "${check}" == "${1}" && "${check}" != "${2}" ]] && echo 1 # ${1} > ${2}
	[[ "${check}" == "${2}" && "${check}" != "${1}" ]] && echo 2 # ${2} > ${1}
	[[ "${check}" == "${1}" && "${check}" == "${2}" ]] && echo 0 # ${1} = ${2}
}
# ver_btwn: echo 1 if any version in $3 lies strictly between $1 and $2 (empty otherwise).
ver_btwn(){
	for between in ${3};do
		if [[ "$(ver_diff "${1}" "${between}" || true)" == "1" && "$(ver_diff "${2}" "${between}" || true)" == "2" ]];then
			echo "1" # we have one_or_more version between ${1} and ${2}
			break
		fi
	done
}
# ============================================================================
# === MASK / UNMASK CLEANUP
# === package_envs, all_mask_trash, mask_trash, remove_trash, stupid_unmask.
# === Detect/remove obsolete mask + unmask entries; used by -sm/-sum/-t/-ft/-f.
# === package_envs parses modern qatom -F output (see ChangeLog 7e5ccd7).
# ============================================================================

# package_envs: parse qatom -F output into the column-aligned format mask helpers expect.
package_envs(){
	for atom in ${1};do
		# portage-utils 0.97+ default qatom output emits the comparison
		# operator as a TRAILING field and "<unset>" as a placeholder for
		# missing PV / SLOT — not the leading-prefix-on-CATEGORY layout the
		# legacy parser assumed.  Use the -F format to get a structured
		# pipe-separated output, then normalise every empty position to
		# the legacy "(null)" placeholder so the consumer-side read at
		# whitespace boundaries gets seven aligned columns regardless of
		# which atom shape the user wrote.
		#
		# Separator MUST be a non-whitespace character: bash's `read` with
		# IFS set to a whitespace char (space/tab/newline) collapses runs
		# of consecutive delimiters into one, dropping intermediate empty
		# fields.  For an atom like "<sys-apps/grep-99" where PR/SLOT are
		# empty but pfx="<", whitespace-IFS read would put "<" into the
		# PR slot.  "|" is invalid in atom syntax → safe.
		while IFS='|' read -r cat pn pv pr slot pfx; do
			[[ "${cat}" == "(null)" || "${pn}" == "(null)" ]] && continue
			[[ "${pv}" == "<unset>" || -z "${pv}" ]] && pv="(null)"
			[[ -z "${pr}" ]] && pr="(null)"
			[[ -z "${slot}" ]] && slot="(null)"
			[[ -z "${pfx}" ]] && pfx="(null)"
			echo "${pfx} ${cat} ${pn} ${pv} ${pr} ${slot} ${file}"
		done <<< "$(qatom -F '%{CATEGORY}|%{PN}|%{PV}|%[PR]|%[SLOT]|%[pfx]' "${atom}")"
	done
}
# all_mask_trash: scan all package.mask + package.unmask for stale or overlapping entries.
all_mask_trash(){
	MASKED=""
	UNMASKED=""
	pre_mask_trash(){
		masked="$(awk '{print $1}' ${file} | grep -v '^#' || true)"
		MASKED+="$(package_envs "${masked}")"$'\n'
	}
	file_or_dir "package.mask" "Preparing atoms in" "pre_mask_trash" || true
	pre_unmask_trash(){
		unmasked="$(awk '{print $1}' ${file} | grep -v '^#' || true)"
		UNMASKED+="$(package_envs "${unmasked}")"$'\n'
	}
	file_or_dir "package.unmask" "Preparing atoms in" "pre_unmask_trash" || true
}
# mask_trash: core mask-cleanup pass — uses qatom + ver_btwn to spot redundancies.
mask_trash(){
	TRASH=""
	# Helper functions used to fire `continue 2` to skip the rest of the
	# inner unmask loop AND continue the outer mask loop's next iteration.
	# That works in bash but is non-portable and trips shellcheck SC2104.
	# Now: set `_trash_hit=1` and let the inner loop's body break out.
	slot_output(){
		# Store the slot-qualified atom so the later first-field removal matches
		# the file's `cat/pn:slot` line exactly (a bare cat/pn would either miss
		# it or, with the old `^cat/pn.*` sed, nuke every slot sibling).
		if [[ "${mslot}" != "(null)" ]];then
			printf '%b\n' "${red}Incorrect${restore}: ${mcategory}/${mpn}:${mslot}"
			TRASH+="${mfile} ${mcategory}/${mpn}:${mslot}"$'\n'
		else
			printf '%b\n' "${red}Incorrect${restore}: ${mcategory}/${mpn}"
			TRASH+="${mfile} ${mcategory}/${mpn}"$'\n'
		fi
		_trash_hit=1
	}
	non_slot_output(){
		printf '%b\n' "${red}Incorrect${restore}: ${msw}${mcategory}/${mpn}-${mver}"
		TRASH+="${mfile} ${msw}${mcategory}/${mpn}-${mver}"$'\n'
		_trash_hit=1
	}
	# all_mask_trash propagates file_or_dir's "missing target" return
	# through `|| true` since the patch making file_or_dir callers
	# tolerate missing optional config.  No file means MASKED/UNMASKED
	# stay empty → the comparison loop below is a no-op → correct.
	all_mask_trash || true
	###### m->masked; u->unmasked
	export OVERLAYS_LIST="no"
	export VERSIONONLY='<version> '
	export FORMAT='<availableversions:VERSIONONLY>'
	while read msw mcategory mpn mver mrev mslot mfile;do
		# Reset per outer-iteration: `_trash_hit` is set by slot_output /
		# non_slot_output when a redundancy is detected, and read by the
		# inner loop's `break` guard at the bottom.
		_trash_hit=0
		# Hoist the eix call OUT of the inner unmask loop: ${versions} and
		# ${oldest} depend only on (mcategory, mpn), not on any inner-loop
		# variable.  Previous nested-call shape was O(N×M) eix forks (up to
		# 2500 for a typical 50+50 mask/unmask config); now it's O(N).
		# Resolve unconditionally per outer iteration when mver may be
		# non-empty after the (null)-strip below — same predicate as the
		# old version-comparison gate but evaluated once.
		[[ "${mrev}" == "(null)" || -z "${mrev}" ]] && _mver="${mver}" || _mver="${mver}-${mrev}"
		[[ "${_mver}" == "(null)" ]] && _mver=""
		versions=""
		oldest=""
		if [[ -n "${_mver}" ]]; then
			versions="$(eix -e "${mcategory}/${mpn}" || true)"
			oldest="$(awk '{print $1}' <<< "${versions}" || true)"
		fi
		unset _mver
		# shellcheck disable=SC2034  # ucategory/upn/ufile are positional placeholders consumed by `read` even though the loop body only references usw/uver/urev/uslot
		while read usw ucategory upn uver urev uslot ufile;do
			versions_diff=""
			versions_btwn=""
			[[ "${mrev}" == "(null)" ]] && mrev="" || mver="${mver}-${mrev}"
			[[ "${urev}" == "(null)" ]] && urev="" || uver="${uver}-${urev}"
			[[ "${mver}" == "(null)" ]] && mver=""
			[[ "${uver}" == "(null)" ]] && uver=""

			# Lazy fetch fallback: if mver was empty but THIS unmask entry
			# has a uver, we still need the version table for ver_diff/
			# ver_btwn below.  Compute once per outer iteration on first
			# need (rare path).
			if [[ -z "${versions}" && -n "${uver}" ]];then
				versions="$(eix -e "${mcategory}/${mpn}" || true)"
				oldest="$(awk '{print $1}' <<< "${versions}" || true)"
			fi

			if [[ -n "${mver}" && -n "${uver}" ]];then
				versions_diff="$(ver_diff "${mver}" "${uver}" || true)"
				versions_btwn="$(ver_btwn "${uver}" "${mver}" "${versions}" || true)"
			fi

			if [[ "${msw}" != "(null)" ]];then
				if [[ "${usw}" == "(null)" && "${uslot}" == "(null)" ]];then
					non_slot_output
				elif [[ "${msw}" == ">" || "${msw}" == ">=" ]];then
					if [[ "${usw}" == ">" || "${usw}" == ">=" ]];then
						if [[ "${versions_diff}" != "1" && -z "${versions_btwn}" ]];then
							non_slot_output
						fi
					fi
				elif [[ "${msw}" == "<" || "${msw}" == "<=" ]];then
					if [[ "${usw}" == "<" || "${usw}" == "<=" ]];then
						if [[ "${versions_diff}" != "1" ]];then
							non_slot_output
						fi
					fi
				fi
			else
				if [[ "${mslot}" == "${uslot}" ]];then
					if [[ "${usw}" == ">=" || "${usw}" == ">" ]];then
						if [[ "$(ver_diff "${uver}" "${oldest}" || true)" != "1" ]];then
							slot_output
						fi
					elif [[ "${usw}" == "<"  && "$(ver_diff "${uver}" "${oldest}" || true)" == "1" ]];then
						slot_output
					elif [[ "${usw}" == "<=" && "$(ver_diff "${uver}" "${oldest}" || true)" != "1" ]];then
						slot_output
					elif [[ "${usw}" == "(null)" ]];then
						slot_output
					fi
				fi
			fi
			# Break inner if a trash entry was just recorded — same effect
			# as the old `continue 2` from inside slot_output/non_slot_output.
			(( _trash_hit )) && break
		done <<< "$(grep " ${mcategory} ${mpn} " <<< "${UNMASKED}" || true)"
	done <<< "${MASKED}"

	files="$(awk '{print $1}' <<< "${TRASH}" | sort -u | sed '/^$/d')"
	for target in ${files};do
		if [[ -f "${target}" ]];then
			tmp_file="$(_mktemp)"
			cp "${target}" "${tmp_file}"
			incorrect="$(grep ${target} <<< "${TRASH}" | sed -e "s|${target} ||g" || true)"
			for trash_atom in ${incorrect};do
				_drop_line "${tmp_file}" "${trash_atom}" field1
			done
			diff_ask "${target}" "${tmp_file}"
		fi
	done
	unset TRASH OVERLAYS_LIST VERSIONONLY FORMAT MASKED UNMASKED versions oldest versions_diff versions_btwn
}
# remove_trash: delete entries flagged as trash; companion to all_mask_trash.
remove_trash(){
	tmp_file="$(_mktemp)"
	cp "${file}" "${tmp_file}"
	for atom in $(eix -Tc#);do
		lines="$(grep "${atom}" "${file}" || true)"
		while IFS= read -r line;do
			entry="$(qatom "$(tr -d '<>=~#' <<< "${line}")" | awk '{print $1,$2}' | tr ' ' '/')"
			if [[ "${atom}" == "${entry}" ]];then
				if ! eix -qe --installed-masked "${entry}";then
					if eix -Iqe "${atom}" > /dev/null;then
						printf '%b\n' "stupid entry:              ${green}${line}${restore}"
					else
						printf '%b\n' "stupid entry (${red}!${restore}installed): ${green}${line}${restore}"
					fi
					_drop_line "${tmp_file}" "${line}"
					break
				fi
			fi
		done <<< "${lines}"
	done
	diff_ask "${file}" "${tmp_file}"
	eend $? 2>/dev/null
}
# stupid_unmask: remove unmask entries for atoms that aren't actually masked.
stupid_unmask(){
	export REDUNDANT_IF_IN_UNMASK="all"
	export REDUNDANT_IF_IN_MASK="no"
	export TEST_FOR_NONEXISTENT="true"
	export REDUNDANT_IF_UNMASK_NO_CHANGE="all"
	file_or_dir "package.unmask" "Checking stupid unmasks:" "remove_trash" || true
	unset REDUNDANT_IF_IN_UNMASK REDUNDANT_IF_IN_MASK TEST_FOR_NONEXISTENT REDUNDANT_IF_UNMASK_NO_CHANGE
}
# ============================================================================
# === PROFILE MASK USE
# === sort_uniq_mask_use, profile_masked_uses, mask_files, use_mask,
# === etc_profile_use_mask, check_use_masked.  Profile use.mask / use.stable.mask
# === handling.  Used by -s/-sup/-uf/-f.
# ============================================================================

# sort_uniq_mask_use: sort + dedupe profile-level use.mask / use.stable.mask entries.
sort_uniq_mask_use(){
	if [[ -d "${PORT_ETC}/profile" || -h "${PORT_ETC}/profile" ]];then
		while IFS= read -r package; do
			tmp_sort="$(_mktemp)"
			printf '%b\n' "${underline}Sorting${restore} ${contrast}${package#${PORT_ETC}/}${restore}"

			# Flat-list comment-preserving dedup.  These files are one
			# USE flag per line (or whitespace-separated tokens) with
			# no atoms — each flag's "header" is the consecutive
			# comment + blank lines immediately above it.  Last-state-
			# wins per base, output in last-occurrence order (matches
			# legacy sort_passed_uses behaviour) with each flag's
			# header emitted just above the flag.
			#
			# Ordering uses a global token counter (++tok_idx) so each
			# token in the input has a unique monotonically-increasing
			# index — no float-precision games and no collisions when
			# a base is re-encountered.
			awk '
				/^[[:space:]]*$|^[[:space:]]*#/ {
					pending_header = pending_header $0 "\n"
					next
				}
				{
					# Each non-comment line may have multiple tokens.
					nf = split($0, tokens, /[[:space:]]+/)
					for (k = 1; k <= nf; k++) {
						tok = tokens[k]
						if (tok == "") continue
						++tok_idx
						base = tok
						sub(/^-/, "", base)
						# First token of the line picks up the pending
						# header; later tokens on the same line have no
						# header.
						if (!(base in seen)) {
							seen[base] = 1
							headers[base] = (k == 1 ? pending_header : "")
						} else if (k == 1 && pending_header != "" && headers[base] == "") {
							headers[base] = pending_header
						}
						last_state[base] = tok
						last_order[base] = tok_idx
					}
					pending_header = ""
				}
				END {
					# Sort bases by their LAST-occurrence token index
					# (ascending = first-seen first in the result,
					# matching legacy sort_passed_uses).
					nb = 0
					for (base in last_order) bases[++nb] = base
					for (i = 2; i <= nb; i++) {
						tmp = bases[i]
						for (j = i; j > 1 && last_order[bases[j-1]] > last_order[tmp]; j--)
							bases[j] = bases[j-1]
						bases[j] = tmp
					}
					for (i = 1; i <= nb; i++) {
						b = bases[i]
						printf "%s%s\n", headers[b], last_state[b]
					}
					if (pending_header != "") printf "%s", pending_header
				}
			' "${package}" > "${tmp_sort}"

			diff_ask "${package}" "${tmp_sort}"
			eend $? 2>/dev/null
		done < <(find "${PORT_ETC}/profile" -type f \! -name '*~' \! -name '*.bak' \( -name "use.stable.mask" -o -name "use.mask" \))
	fi
}

# profile_masked_uses: collect USE flags masked by the current profile (recurses via parent).
profile_masked_uses() {
	all_uses=""
	file="${1}/${2}"
	if [[ -f "${file}" ]];then
		all_uses+="$(grep "^[^#].*$" "${file}" || true)"$'\n'
	fi
	if [[ -f "${1}/parent" ]]; then
		while IFS= read -r path; do
			profile_masked_uses "${1}/${path}" "${2}"
		done < "${1}/parent"
	fi
}

# mask_files: list profile mask files to consider (honours ACCEPT_KEYWORDS).
mask_files() {
	if grep -q "~" <<< "$(eix --print ACCEPT_KEYWORDS)";then
		echo "use.mask"
	else
		echo "use.mask use.stable.mask"
	fi
}

# use_mask: extract USE-flag masks from the current profile chain.
use_mask() {
	makeprof=""
	[[ -h "/etc/make.profile" ]] && makeprof="/etc/make.profile"
	[[ -h "${PORT_ETC}/make.profile" ]] && makeprof="${PORT_ETC}/make.profile"
	for target in $(mask_files);do
		profile_masked_uses "$(readlink -f "${makeprof}")" "${target}"
	done
	sort_passed_uses "${all_uses} " | tr "[:space:]" $'\n'
}

# etc_profile_use_mask: remove redundant entries from $PORT_ETC/profile/use.mask already handled by the profile chain.
etc_profile_use_mask() {
	if [[ -f "${PORT_ETC}/profile/use.mask" ]];then
		orig_file="${PORT_ETC}/profile/use.mask"
	else
		return 1
	fi
	tmp_file="$(_mktemp)"
	cp "${orig_file}" "${tmp_file}"
	while read use;do
		if grep -q "^${use}$" <<< "$(use_mask)";then
			if grep -q "^-" <<< "${use}";then
				printf '%b\n' "Twice unmasked: ${red}${use}${restore}"
				_drop_line "${tmp_file}" "${use}"
			else
				printf '%b\n' "Twice masked: ${red}${use}${restore}"
				_drop_line "${tmp_file}" "${use}"
			fi
		else
			if grep -q "^-" <<< "${use}";then
				printf '%b\n' "Stupid unmask: ${red}${use}${restore}"
				_drop_line "${tmp_file}" "${use}"
			fi
		fi
	done < "${orig_file}"
	diff_ask "${orig_file}" "${tmp_file}"
}

# check_use_masked: process $PORT_ETC/profile/use.{mask,stable.mask} via etc_profile_use_mask to drop redundant entries.
check_use_masked() {
	for target in $(mask_files);do
		file_or_dir "profile/${target}" "Checking masked uses:" "etc_profile_use_mask" || true
	done
}
# ============================================================================
# === WORLD REBUILD
# === regen_world.  Rebuilds /var/lib/portage/world: writes `qlist -CI` as a
# === draft, subtracts the full `emerge -eopd --with-bdeps=y world` tree
# === (narrowed by `emerge -epO system` + qlist), drops virtuals / *-libs,
# === then interactively walks `emerge -pc` candidates to add back.  Used by -wg.
# ============================================================================

# regen_world: rebuild $WORLD: keep installed atoms not pulled in by `emerge -eopd --with-bdeps=y world` (filtered through `emerge -epO system` + qlist), excluding virtuals/*-libs; then interactively walk `emerge -pc` candidates.
regen_world(){
	notrash_pkgs=""
	tmp_world="$(_mktemp)"
	ex_world="$(_mktemp)"
	emerge_log="$(_mktemp)"
	mv "${WORLD}" "${ex_world}"
	installed="$(qlist -CI | sort -u)"
	echo "${installed}" > "${WORLD}"
	printf '%b\n' "Calculating dependencies"

	pre_pre="$(emerge -eopd --columns --with-bdeps=y world 2>"${emerge_log}")" || {
		mv "${ex_world}" "${WORLD}"
		cat "${emerge_log}"
		rm "${tmp_world}" "${emerge_log}"
		printf '%b\n' "\n${red}ERROR!!!${restore} exit\n"
		exit 1
	}
	rm "${emerge_log}"

	pretend="$(grep -v "blocks" <<< "${pre_pre}" | awk '/^\[/ {print $4}' || true)" && eend 0 2>/dev/null
	# Command substitution strips trailing newlines, so `pretend` does NOT
	# end in $'\n' after the previous line.  Insert one before the next
	# block, otherwise the last eopd atom is concatenated with the first
	# qlist atom on a single line and downstream `^atom$` lookups miss.
	#
	# Guard the qlist call with an explicit empty-check on its atom args:
	# when `emerge -epO system | awk` produces no output (broken Portage
	# state, missing system set, etc.), `qlist -CI` with zero atom args
	# would return the FULL installed list — every atom would then end
	# up in pretend, every installed atom would match, and @world would
	# never get cleaned.  Skipping the append in that case is correct:
	# system-set atoms only narrow pretend; they don't add anything that
	# wasn't already covered by the eopd output above.
	_system_atoms="$(emerge -epO system 2>/dev/null | awk '/\[/ {print $4}' || true)"
	if [[ -n "${_system_atoms}" ]];then
		pretend+=$'\n'"$(qlist -CI ${_system_atoms} || true)"$'\n'
	fi
	unset _system_atoms

	for atom in ${installed};do
		if ! grep -q "^${atom}$" <<< "${pretend}" && ! grep -q ".*-libs/" <<< "${atom}" && ! grep -q "virtual/" <<< "${atom}";then
				echo "${atom}" >> "${tmp_world}"
				printf '%b\n' "world++: ${green}${atom}${restore}"
		fi
	done
	cp "${tmp_world}" "${WORLD}"

	PS3="$(printf '%b\n' "${contrast}Choose package which you want save:${restore} ")"
	choose_target(){
		select target in ${pretend};do
			echo "=${target}"
			break
		done
	}
	add_in_world(){
		notrash_pkgs+=" $(choose_target)"
		for tp in ${notrash_pkgs};do
			pretend="$(sed -e "s|^${tp#=}$||" -e '/^$/d' <<< "${pretend}")"
		done
	}
	ask(){
		pretend="$(emerge -pc | grep 'All selected packages:' | sed 's|.*:||1' | tr ' ' $'\n' || true)"
		printf '%b\n' "\n${pretend// /$'\n'}"
		if [[ -n "$(sed '/^$/d' <<< "${pretend}")" ]];then
			printf '%b' "\n${contrast}Would you like save some packages?${restore} [${green}Yes${restore}/${red}No${restore}] "
			while read x;do
				[[ -z "$(sed '/^$/d' <<< "${pretend}")" ]] && break
				case ${x} in
					Yes | YES | yes | Y | y | "" )
						add_in_world;
						while [[ -z "${enough}" && "$(echo "${pretend// /$'\n'}" | sed '/^$/d' | wc -l)" != "0" ]];do
							printf '%b' "${contrast}More?${restore} [${green}Yes${restore}/${red}No${restore}] "
							while read y;do
								case ${y} in
									Yes | YES | yes | Y | y | "" )
										add_in_world;
										break;;
									No | NO | no | N | n )
										enough="1"
										break;;
									* ) printf '%b' "Sorry, response '${y}' not understood. [${green}Yes${restore}/${red}No${restore}] "
										continue;;
								esac
							done
						done
						break;;
					No | NO | no | N | n )
						break;;
					* ) printf '%b' "Sorry, response '${x}' not understood. [${green}Yes${restore}/${red}No${restore}] "
						continue;;
				esac
			done
			[[ -n "$(sed '/^$/d' <<< "${notrash_pkgs}")" ]] && emerge -Own ${notrash_pkgs}
		else
			return 0
		fi
	}
	for t in 1 2;do
		[[ "${t}" == "1" ]] && printf '%b\n' "\nemerge -pc: ${green}check...${restore}"
		[[ "${t}" == "2" ]] && printf '%b\n' "\nemerge -pc: ${green}recheck...${restore}"
		ask
		unset enough
	done
	cp "${WORLD}" "${tmp_world}"
	cp "${ex_world}" "${WORLD}"
	diff_ask "${WORLD}" "${tmp_world}"
	rm "${ex_world}"
	eend $? 2>/dev/null
	printf '%b\n' "\n${green}Result${restore}:"
	cat "${WORLD}"
}
# ============================================================================
# === OVERLAYS
# === overlays.  Remove unused overlays declared in $PORT_ETC/repos.conf and
# === stale $DEP_PATH metadata.  Used by -fr.
# ============================================================================

# overlays: remove unused overlays from $PORT_ETC/repos.conf and stale $DEP_PATH metadata.
overlays(){
	UNUSED=""
	TRASH_REPO=""
	bad_links=""
	used_repos=""
	good_links=""
	portage_overlays=""
	# stop is set inside fix_deps() when there's nothing left to clean
	# and consumed by the outer dep-cache loop.  Pre-declare to avoid
	# `unbound variable` under set -u on the first loop iteration.
	stop=""

	######## build repo list from repos.conf (honors PORT_ETC override)
	portage_overlays="$(
		{ cat "${PORT_ETC}/repos.conf" 2>/dev/null || true
		  cat "${PORT_ETC}/repos.conf"/*.conf 2>/dev/null || true; } |
		awk '/^\[/{gsub(/[\[\]]/,""); repo=$0; next}
		     /^location[[:space:]]*=/{
		       gsub(/^location[[:space:]]*=[[:space:]]*/,"")
		       if (repo != "DEFAULT") print $0 " " repo
		     }' | sort -u
	)"

	######## parent_repo for installed packages
	echo "Checking installed packages..."
	_tput sc
	_tput civis
	for i in ${PKGDB}/*/*/repository;do
		_tput el
		_tput el1
		output="${i#${PKGDB}/}"
		output="${output%/repository}"
		printf '%s' "${output}"
		_tput rc
		used_repos+="$(grep -sv '^gentoo$' "${i}" || true)"$'\n'
	done
	_tput el
	_tput cnorm
	used_repos="$(sort -u <<< "${used_repos%$'\n'}")"

	for repo in ${used_repos};do
		repo_path="$(grep " ${repo}$" <<< "${portage_overlays}" | awk '{print $1}' || true)"
		if [[ -d "${repo_path}" ]];then
			######## checking symlinks in repo
			while IFS= read -r x; do
				target="$(readlink ${x})"
				if [[ -e "${target}" || -e "${x%/*}/${target}" ]];then
					good_links+="${target}"$'\n'
				else
					bad_links+="${repo} ${x}"$'\n'
				fi
			done < <(find "${repo_path}" -type l)
		else
			TRASH_REPO+="repo '${green}${repo}${restore}' used, but not found in repos.conf"$'\n'
			continue
		fi
	done

	######## unused overlays: repos.conf entries (excl. gentoo) with no installed packages
	# Default IFS is intentional here: each portage_overlays line is
	# "<location> <name>" and we want field-splitting on the space.
	# `IFS= read -r` would put the whole line in ${path} and leave
	# ${name} empty, silently skipping every entry.
	while read -r path name; do
		[[ -z "${name}" || "${name}" == "gentoo" ]] && continue
		grep -q "^${name}$" <<< "${used_repos}" || UNUSED+="${name}"$'\n'
	done <<< "${portage_overlays}"
	UNUSED="$(sort -u <<< "${UNUSED}" | sed '/^$/d')"

	if [[ -n "${bad_links}" ]];then
		echo "broken symlinks:"
		echo "${bad_links}"
		printf '%b' "\n${contrast}Would you like remove?${restore} [${green}Yes${restore}/${red}No${restore}] "
		while read z;do
			case ${z} in
				Yes | YES | yes | Y | y | "" )
					for symlink in $(awk '{print $2}' <<< "${bad_links%$'\n'}");do
						rm -v "${symlink}"
						eend $? 2>/dev/null
					done
					break;;
				No | NO | no | N | n )
					break;;
				* ) printf '%b' "Sorry, response '${z}' not understood. [${green}Yes${restore}/${red}No${restore}] "
					continue;;
			esac
		done
	fi

	choose_target(){
		PS3="$(printf '%b\n' "${contrast}Choose repo which you want save:${restore} ")"
		select target in ${UNUSED};do
			echo "${target}"
			break
		done
	}
	ask(){
		[[ -n "${UNUSED}" ]] && printf '%b\n' "Unused repos:\n${UNUSED}"
		if [[ -n "$(sed '/^$/d' <<< "${UNUSED}")" ]];then
			printf '%b' "\n${contrast}Would you like save some repo(s)?${restore} [${green}Yes${restore}/${red}No${restore}] "
			while read x;do
				[[ -z "$(sed '/^$/d' <<< "${UNUSED}")" ]] && break
				case ${x} in
					Yes | YES | yes | Y | y | "" )
						UNUSED="$(grep -v "^$(choose_target)$" <<< "${UNUSED}" || true)"
						while [[ -z "${enough}" && "$(echo "${UNUSED// /$'\n'}" | sed '/^$/d' | wc -l)" != "0" ]];do
							printf '%b' "${contrast}More?${restore} [${green}Yes${restore}/${red}No${restore}] "
							while read y;do
								case ${y} in
									Yes | YES | yes | Y | y | "" )
										UNUSED="$(grep -v "^$(choose_target)$" <<< "${UNUSED}" || true)"
										break;;
									No | NO | no | N | n )
										enough="1"
										break;;
									* ) printf '%b' "Sorry, response '${y}' not understood. [${green}Yes${restore}/${red}No${restore}] "
										continue;;
								esac
							done
						done
						break;;
					No | NO | no | N | n )
						break;;
					* ) printf '%b' "Sorry, response '${x}' not understood. [${green}Yes${restore}/${red}No${restore}] "
						continue;;
				esac
			done
		else
			return 0
		fi
	}
	fix_deps(){
		# DEP_PATH is set as an overridable global at init (line 43) so that
		# test sandboxes don't sweep the host's real /var/cache/edb/dep when
		# the test repos.conf doesn't list every overlay the host has cache
		# entries for.
		TRASH=""
		while IFS= read -r dep_path; do
			repo_path="$(sed "s|${DEP_PATH}||" <<< "${dep_path}")"
			dep_file="${dep_path}.sqlite"
			if [[ -n "${repo_path}" ]];then
				if [[ ! -d "${repo_path}" ]];then
					TRASH+="${dep_path} "
					[[ -f "${dep_file}" ]] && TRASH+="${dep_file} "
				elif [[ -d "${repo_path}" && ! "$(ls -A ${repo_path})" ]];then
					TRASH+="${dep_path} "
					[[ -f "${dep_file}" ]] && TRASH+="${dep_file} "
				elif [[ -d "${repo_path}" && ! "$(ls -A ${dep_path})" && ! -f "${dep_file}" ]];then
					TRASH+="${dep_path} "
				elif [[ -d "${repo_path}" && "$(ls -A ${dep_path})" && -f "${dep_file}" ]];then
					file_stamp="$(timestamp "${dep_file}")"
					path_stamp="$(timestamp ${dep_path}/*)"
					if [[ -n "${file_stamp}" && -n "${path_stamp}" ]] && (( "${file_stamp}" > "${path_stamp}" ));then
						TRASH+="${dep_path}/* "
					elif [[ -n "${file_stamp}" && -n "${path_stamp}" ]] && (( "${file_stamp}" < "${path_stamp}" ));then
						TRASH+="${dep_file} "
					fi
				fi
			fi
		done < <(find "${DEP_PATH}" -type d)
		if [[ -n "${TRASH}" ]];then
			echo "${TRASH}"
		else
			stop="true"
		fi
	}
	ask
	# -f: eselect refuses to remove `local` (not in its remote registry) and
	# `no-sync-uri` overlays without it -- which covers most hand-added
	# overlays.  These are already confirmed UNUSED (no installed packages)
	# and survived the save-prompt above, so force the removal; -f also
	# rm -rf's the overlay dir, the same as the no-flag path already does for
	# the removable remote overlays.
	for repo in ${UNUSED}; do
		if eselect repository remove -f "${repo}" 2>/dev/null; then
			eend 0 2>/dev/null
		else
			printf '%b\n' "Could not auto-remove ${red}${repo}${restore}: run: eselect repository remove -f ${repo}"
			eend 1 2>/dev/null
		fi
	done
	printf '%b\n' "\n${TRASH_REPO}"
	echo "dep-cache:"
	while [[ -z "${stop}" ]];do
		trash="$(fix_deps)"
		if [[ -n "${trash}" ]];then
			printf '%b\n' "$(tr ' ' $'\n' <<< "${trash% }" | sed "s|^|removing:\\${green}|;s|$|\\${restore}|")"
			rm -rf "${trash}" 2>/dev/null || { echo failed; exit 1; }
		else
			break
			
		fi
	done
	echo "done"
	eend 0 2>/dev/null
}
# ============================================================================
# === HELP TEXT
# === help_pc.  The --help output; the eix_dep_keys flag table in DISPATCH
# === below must stay in sync with this text.
# ============================================================================

# help_pc: the --help output; canonical flag inventory (dispatcher table must stay in sync).
help_pc(){
printf '%b\n' \
"Usage: portconf [OPTION] [OPTION]…[OPTION]
available OPTIONS:

${contrast}Common${restore}
	-rc, --regen-cache:          Create and use temporary eix-cache and some fix for overlays. ${red}Highly recommend!${restore}
	-b,  --backup:               Create backup for current /etc/portage state.
	-r,  --restore:              Rolling up /etc/portage to one of available states.
	-s,  --sort:                 Sort and deduplicate USE flags, keywords, all package.* files, and profile/use.mask.
	-y,  --yes:                  Auto answer (Yes).
	-p,  --pretend:              Check only.
	-h,  -?, h, --help:          This help.
${contrast}\${USE}${restore}
	-us, --use-sort:             Sort useflags. Remove doubles and preserve only last defined state (on/off).
	-ui, --use-invalid:          Delete invalid or twice global-defined useflags.
	-um, --use-make:             Delete profile defined useflags from make.conf.
	-sup,--stupid-use-profile:   Delete incorrect or twice masked/unmasked useflags.
	-uf, --use-full:             An analog '-us -ui -um -sup'.
${contrast}\${KEYWORDS}${restore}:
	-ku, --keyword-uniq:         Like '-us', but for keywords.
	-ko, --keyword-one:          Save only latest defined keyword.
${contrast}Trash${restore}:
	-t,   --trash:               Delete not_found/not_installed atoms, empty/backup/unused files.
	-ft,  --force-trash:         Delete all not_installed entries.(exclude package.mask file/dir)
	-sm,  --stupid-mask:         Remove incorrect masked atoms.
	-sum, --stupid-unmask:       Remove incorrect unmasked atoms.
	-c,   --rm-comments:         Delete lines starting with comment.
	-ac,  --rm-all-comments:     Delete all comments.
	-f,   --full:                An analog '-s -t -uf -ku -sm -sum'
${contrast}Converting${restore}:
	-f2d, --files-2-dirs:        Converting package.* files to directories(comments will be removed).
	-d2f, --dirs-2-files:        Converting package.* dirs to files.
${contrast}Profile${restore}:
	-apu, --all-profiles-use:    List \${USE} defined in profiles.
	-pu,  --profiles-use:        List \${USE} of profile.
	-cpu, --current-profile-use: \${USE} of current profile.
${contrast}World${restore}:
	-wb, --world-backup:         Create backup for current world file state.
	-wr, --world-restore:        Rolling up world file to one of available states.
	-wg, --world-regen:          Regen(cleanup) the world file.(backup: auto)
${contrast}Overlays${restore}:
	-fr, --fix-repos:            Remove unused overlays and dep-cache.
${contrast}Misc${restore}:
	-V,  --version:              Print version and exit.

OPTIONS must be separated by SPACE."
}
# ============================================================================
# === DISPATCH  (run_it)
# === PORTCONF_NO_MAIN sourcing guard, flag pre-strip (--yes, --pretend),
# === eix bootstrap decision (eix_check vs eix_method), then the case
# === dispatcher that calls the right combo of funcs for each user flag.
# ============================================================================

eix_dep_keys="--use-invalid
-ui
--use-make
-um
--use-full
-uf
--trash
-t
--force-trash
-ft
--full
-f"
# Sourcing guard: `source portconf.in` from tests sets PORTCONF_NO_MAIN=1
# to get function definitions without executing the command dispatch.
if [[ "${PORTCONF_NO_MAIN:-}" != "1" && "${BASH_SOURCE[0]}" == "$0" ]]; then
opts=" ${PORTCONF_DEFAULT_OPTS:-} ${*}"
grep -q -e " --yes\>" -e " -y\>" <<< " ${opts}" && yes="1"
grep -q -e " --pretend\>" -e " -p\>" <<< " ${opts}" && PRETEND="1"
opts="$(sed -e 's| --yes\>||g;s| -y\>||g' -e 's| --pretend\>||g;s| -p\>||g' <<< " ${opts}")"
# Save the dispatch-entry stdin on fd 9.  diff_ask / remove_ask read
# Yes/No answers from fd 9 because most callers wrap them inside
# `while ...; done < <(find ...)` loops (sort_uniq_files, file_or_dir's
# directory branch, force_not_installed, empty_files, backup_files, …)
# whose process-substitution redirect overwrites fd 0 for the body.
# Without the dup, a bare `read x` inside the prompt would hit EOF on
# the find output and the function would silently fall through and rm
# the tmp file with no mutation applied.
# fd 9 specifically because fd 3 is reserved by bats for its own output
# channel — if we dup-ed onto 3 the unit tests would read bats's stream
# instead of the test's heredoc-fed stdin.
exec 9<&0
if grep -q -- "${eix_dep_keys}" <<< "${opts}";then
	if grep -q -e " --regen-cache\>" -e " -rc\>" <<< " ${opts}";then
		eix_check
		opts="$(sed -e 's| --regen-cache\>||g;s| -rc\>||g' -e '/^[ \t]$/d' <<< " ${opts}")"
	else
		eix_method
	fi
else
	opts="$(sed -e 's| --regen-cache\>||g;s| -rc\>||g' -e '/^[ \t]$/d' <<< " ${opts}")"
fi
# Use $# instead of -z "${@}" — the latter relied on implicit array-
# concatenation inside [[ ]] (worked, but tripped SC2199).
[[ $# -eq 0 || -z "${opts}" ]] && help_pc
for OPT in ${opts};do
	case "${OPT}" in
	--backup | -b ) backup;;
	--restore | -r ) etc_restore;;
	--sort | -s )
		backup;
		sort_use_file;
		uniq_keywords;
		sort_uniq_files;
		sort_uniq_mask_use;;
	--use-sort | -us )
		backup;
		sort_use_file;;
	--use-invalid | -ui )
		backup;
		invalid_uses;
		invalid_uses_make;
		# When eix_method was used (existing host cache, no temp file created),
		# eix_cache is empty and the cleanup is a no-op.  Wrap in `|| true`
		# so the compound never returns false — otherwise this becomes the
		# last command of the case arm, propagates up through the dispatch
		# loop, and the binary exits 1 despite every preceding step succeeding.
		{ [[ -n "${eix_cache:-}" ]] && rm "${eix_cache}" && unset eix_cache EIX_CACHEFILE; } || true ;;
	--use-make | -um )
		backup;
		use_makeconf;;
	--stupid-use-profile | -sup )
		backup;
		sort_uniq_mask_use;
		check_use_masked;;
	--use-full | -uf )
		backup;
		sort_use_file;
		sort_uniq_mask_use;
		invalid_uses;
		invalid_uses_make;
		use_makeconf;
		check_use_masked;
		# When eix_method was used (existing host cache, no temp file created),
		# eix_cache is empty and the cleanup is a no-op.  Wrap in `|| true`
		# so the compound never returns false — otherwise this becomes the
		# last command of the case arm, propagates up through the dispatch
		# loop, and the binary exits 1 despite every preceding step succeeding.
		{ [[ -n "${eix_cache:-}" ]] && rm "${eix_cache}" && unset eix_cache EIX_CACHEFILE; } || true ;;
	--keyword-one | -ko )
		backup;
		sort_keywords;;
	--keyword-uniq | -ku )
		backup;
		uniq_keywords;;
	--trash | -t )
		backup;
		not_found;
		package_env_conf;
		package_env;
		env_not_installed;
		empty_files;
		backup_files;
		# When eix_method was used (existing host cache, no temp file created),
		# eix_cache is empty and the cleanup is a no-op.  Wrap in `|| true`
		# so the compound never returns false — otherwise this becomes the
		# last command of the case arm, propagates up through the dispatch
		# loop, and the binary exits 1 despite every preceding step succeeding.
		{ [[ -n "${eix_cache:-}" ]] && rm "${eix_cache}" && unset eix_cache EIX_CACHEFILE; } || true ;;
	--stupid-mask | -sm )
		backup;
		mask_trash;;
	--stupid-unmask | -sum )
		backup;
		stupid_unmask;;
	--force-trash | -ft )
		backup;
		not_found;
		package_env_conf;
		package_env;
		env_not_installed;
		force_not_installed;
		empty_files;
		backup_files;
		# When eix_method was used (existing host cache, no temp file created),
		# eix_cache is empty and the cleanup is a no-op.  Wrap in `|| true`
		# so the compound never returns false — otherwise this becomes the
		# last command of the case arm, propagates up through the dispatch
		# loop, and the binary exits 1 despite every preceding step succeeding.
		{ [[ -n "${eix_cache:-}" ]] && rm "${eix_cache}" && unset eix_cache EIX_CACHEFILE; } || true ;;
	--rm-comments | -c )
		backup;
		rm_comments;;
	--rm-all-comments | -ac )
		backup;
		rm_all_comments;;
	--full | -f )
		backup;
		sort_uniq_files;
		not_found;
		package_env_conf;
		package_env;
		env_not_installed;
		sort_use_file;
		sort_uniq_mask_use;
		invalid_uses;
		invalid_uses_make;
		use_makeconf;
		check_use_masked;
		uniq_keywords;
		mask_trash;
		stupid_unmask;
		empty_files;
		backup_files;
		# When eix_method was used (existing host cache, no temp file created),
		# eix_cache is empty and the cleanup is a no-op.  Wrap in `|| true`
		# so the compound never returns false — otherwise this becomes the
		# last command of the case arm, propagates up through the dispatch
		# loop, and the binary exits 1 despite every preceding step succeeding.
		{ [[ -n "${eix_cache:-}" ]] && rm "${eix_cache}" && unset eix_cache EIX_CACHEFILE; } || true ;;
	--files-2-dirs | -f2d )
		backup;
		f_to_d;;
	--dirs-2-files | -d2f )
		backup;
		d_to_f;;
	--all-profiles-use | -apu ) all_use_all_profiles;;
	--profiles-use | -pu ) profile_use;;
	--current-profile-use | -cpu ) current_profile;;
	--world-backup | -wb ) world_backup;;
	--world-restore | -wr ) world_restore;;
	--world-regen | -wg )
		world_backup;
		regen_world;;
	--fix-repos | -fr )
		overlays;;
	--version | -V ) echo "portconf ${PACKAGE_VERSION}"; exit 0;;
	--help | -h | -? | h ) help_pc;;
	esac
done
_status_pc
fi # PORTCONF_NO_MAIN / sourcing guard
